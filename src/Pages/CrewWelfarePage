// ─── ERROR BOUNDARY ───────────────────────────────────────────────────────────
class ErrorBoundary extends Component {
  constructor(props) { super(props); this.state = { hasError: false, error: "" }; }
  static getDerivedStateFromError(e) { return { hasError: true, error: e?.message || "Unknown error" }; }
  render() {
    if (this.state.hasError) return (
      <div style={{ padding: "2rem", textAlign: "center", color: "#FF4757" }}>
        <div style={{ fontSize: "2rem", marginBottom: 12 }}>⚠️</div>
        <div style={{ fontFamily: "'Orbitron',monospace", fontSize: "0.8rem", marginBottom: 8 }}>Tool Error</div>
        <div style={{ fontSize: "0.72rem", color: "#8A9BBF", marginBottom: 16 }}>{this.state.error}</div>
        <button onClick={() => this.setState({ hasError: false, error: "" })}
          style={{ background: "rgba(0,180,216,0.15)", border: "1px solid #00B4D8", borderRadius: 8,
            color: "#00B4D8", padding: "6px 16px", cursor: "pointer", fontSize: "0.75rem" }}>
          ↺ Retry
        </button>
      </div>
    );
    return this.props.children;
  }
}

