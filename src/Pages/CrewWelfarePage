// ── LEAVE ─────────────────────────────────────────────────────────────────────
function LeaveTool() {
  const [join,setJoin]=useState(""), [contract,setContract]=useState("9"), [ratio,setRatio]=useState("1:2"), [planned,setPlanned]=useState("30");
  const rm={"1:1":1,"1:2":0.5,"1:3":0.333,"2:1":2,"3:1":3};
  const cm=parseFloat(contract)||0, pl=parseFloat(planned)||0, rv=rm[ratio]||0.5;
  const sea=cm*30, ear=sea*rv, bal=ear-pl;
  const addD=(base,amo,ady)=>{
    if(!base)return null;
    try{const d=new Date(base);if(isNaN(d.getTime()))return null;d.setMonth(d.getMonth()+(amo||0));d.setDate(d.getDate()+(ady||0));return d.toLocaleDateString("en-GB",{day:"2-digit",month:"short",year:"numeric"});}catch(e){return null;}
  };
  return (
    <div>
      <Head icon="🗓" title="Leave Planner" sub="Earned leave and next sign-on date"/>
      <G2>
        <div><Lbl>JOIN DATE</Lbl><Inp type="date" value={join} onChange={e=>setJoin(e.target.value)}/></div>
        <div><Lbl>CONTRACT (MO)</Lbl><Inp type="number" value={contract} onChange={e=>setContract(e.target.value)} placeholder="9"/></div>
      </G2>
      <G2>
        <div><Lbl>LEAVE RATIO</Lbl><Sel value={ratio} onChange={e=>setRatio(e.target.value)}>{Object.keys(rm).map(r=><option key={r}>{r}</option>)}</Sel></div>
        <div><Lbl>PLANNED LEAVE DAYS</Lbl><Inp type="number" value={planned} onChange={e=>setPlanned(e.target.value)} placeholder="30"/></div>
      </G2>
      {cm>0&&<Box style={{marginTop:12}}>
        <Row label="Sea Days"                  value={f(sea,0)+" days"}/>
        <Row label={"Earned Leave "+ratio}     value={f(ear,0)+" days"} color="#60a5fa"/>
        {addD(join,cm)&&<Row label="Contract End"      value={addD(join,cm)} color="#fbbf24"/>}
        {addD(join,cm,pl)&&<Row label="Est. Next Sign-On" value={addD(join,cm,pl)} color="#4ade80"/>}
        <Row label="Leave Balance" value={f(bal,0)+" days"} color={bal>=0?"#4ade80":"#ef4444"}/>
      </Box>}
    </div>
  );
}

// ── RELIEF ────────────────────────────────────────────────────────────────────
function ReliefTool() {
  const [join,setJoin]=useState(""), [minMo,setMinMo]=useState("7"), [maxMo,setMaxMo]=useState("11");
  const today=new Date();
  const addM=(ds,mo)=>{if(!ds)return null;try{const d=new Date(ds);if(isNaN(d.getTime()))return null;d.setMonth(d.getMonth()+(mo||0));return d;}catch(e){return null;}};
  const fD=d=>d?d.toLocaleDateString("en-GB",{weekday:"short",day:"2-digit",month:"short",year:"numeric"}):"--";
  const minD=addM(join,parseFloat(minMo)||0), maxD=addM(join,parseFloat(maxMo)||0);
  const dob=join?Math.floor((today-new Date(join))/86400000):null;
  const dtm=minD?Math.max(0,Math.ceil((minD-today)/86400000)):null;
  const dtx=maxD?Math.max(0,Math.ceil((maxD-today)/86400000)):null;
  const inW=(minD&&maxD)?(today>=minD&&today<=maxD):false;
  return (
    <div>
      <Head icon="🔄" title="Relief Date Calculator" sub="Track your relief window"/>
      <div style={{display:"grid",gridTemplateColumns:"1fr 1fr 1fr",gap:10,marginBottom:4}}>
        <div><Lbl>JOIN DATE</Lbl><Inp type="date" value={join} onChange={e=>setJoin(e.target.value)}/></div>
