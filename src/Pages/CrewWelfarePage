// ─── TOOL: OVERTIME CALCULATOR ────────────────────────────────────────────────

function OvertimeCalculator() {
  var [basic, setBasic]     = useState("");
  var [currency, setCurrency] = useState("USD");
  var [worked, setWorked]   = useState("");
  var [regular, setRegular] = useState("208");
  var [mult, setMult]       = useState("1.25");

  var b   = parseFloat(basic)   || 0;
  var hw  = parseFloat(worked)  || 0;
  var rh  = parseFloat(regular) || 208;
  var or  = parseFloat(mult)    || 1.25;
  var cur = CURRENCIES.find(function(c){return c.code===currency;}) || {};
  var hr  = rh > 0 ? b / rh : 0;
  var oth = Math.max(0, hw - rh);
  var otp = oth * hr * or;
  var tot = Math.min(hw,rh)*hr + otp;

  return (
    <div>
      <SectionHeader icon="⏱" title="Overtime Calculator" subtitle="MLC 2006 compliant" />
