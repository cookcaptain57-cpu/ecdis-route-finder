            <div><Label>End Date</Label><Input type="date" value={form.end} onChange={v => setForm(f => ({ ...f, end: v }))} /></div>
          </div>
          <Label>Notes</Label>
          <textarea value={form.notes} onChange={e => setForm(f => ({ ...f, notes: e.target.value }))}
            placeholder="Flag, trade area, vessel type..."
            style={{ width: "100%", minHeight: 50, background: "var(--bg2)", border: "1px solid var(--border2)", borderRadius: 8, padding: "0.5rem 0.8rem", color: "var(--text)", fontSize: "0.82rem", fontFamily: "'Exo 2', sans-serif", resize: "vertical", outline: "none", marginBottom: 10 }} />
          <Btn onClick={addContract}>💾 Save Contract</Btn>
        </Card>
      )}

      {contracts.length === 0 && !adding && (
        <Card><div style={{ textAlign: "center", color: "var(--text3)", fontSize: "0.8rem", padding: "1rem 0" }}>No contracts logged yet. Add your first one above.</div></Card>
      )}

      {contracts.map(c => {
        const days = c.start && c.end ? Math.max(0, Math.floor((new Date(c.end) - new Date(c.start)) / 86400000)) : null;
        return (
          <Card key={c.id} style={{ marginBottom: 8 }}>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start" }}>
              <div>
                <div style={{ fontFamily: "'Orbitron', monospace", fontSize: "0.85rem", color: "var(--cyan)", marginBottom: 4 }}>{c.vessel}</div>
                <div style={{ fontSize: "0.78rem", color: "var(--text2)" }}>{c.rank}{c.company ? ` · ${c.company}` : ""}</div>
                <div style={{ fontSize: "0.72rem", color: "var(--text3)", marginTop: 4 }}>
