// ─── MAIN PAGE ────────────────────────────────────────────────────────────────
export default function CrewWelfarePage() {
  const [activeTab,  setActiveTab]  = useState("finance");
  const [activeTool, setActiveTool] = useState("currency");

  const currentTab  = CW_TABS.find(t => t.key === activeTab)  || CW_TABS[0];
  const currentTool = currentTab.tools.find(t => t.key === activeTool) || currentTab.tools[0];
  const ToolComponent = currentTool.C;

  const switchTab = (key) => {
    const found = CW_TABS.find(t => t.key === key);
    if (!found) return;
    setActiveTab(key);
    setActiveTool(found.tools[0].key);
  };

  return (
    <div style={{ flex:1, display:"flex", flexDirection:"column", minHeight:0 }}>

      {/* Header */}
      <div style={{ padding:"1rem 1.2rem 0" }}>
        <div style={{ display:"flex", alignItems:"center", gap:11, marginBottom:4 }}>
          <div style={{ width:38, height:38, background:"linear-gradient(135deg,var(--cyan),var(--purple))", borderRadius:10, display:"flex", alignItems:"center", justifyContent:"center", fontSize:"1rem", boxShadow:"0 0 14px rgba(0,180,216,0.3)" }}>⚓</div>
          <div>
            <div style={{ fontFamily:"'Orbitron',monospace", fontSize:"0.88rem", fontWeight:700 }}>CREW WELFARE</div>
            <div style={{ fontSize:"0.62rem", color:"var(--cyan)", textTransform:"uppercase", letterSpacing:"0.12em" }}>Financial · Planning · Wellbeing</div>
          </div>
        </div>
      </div>

      {/* Main Tabs */}
      <div style={{ display:"flex", borderBottom:"1px solid var(--border)", padding:"0.75rem 1.2rem 0", gap:4 }}>
        {CW_TABS.map(t => (
          <button key={t.key} onClick={() => switchTab(t.key)} style={{
            flex:1, padding:"0.45rem 0",
            background: activeTab===t.key ? "rgba(0,180,216,0.12)" : "transparent",
            border:"none",
            borderBottom:`2px solid ${activeTab===t.key?"var(--cyan)":"transparent"}`,
            borderRadius:"6px 6px 0 0",
            color: activeTab===t.key ? "var(--cyan)" : "var(--text3)",
            fontFamily:"'Orbitron',monospace", fontSize:"0.6rem", fontWeight:700,
            letterSpacing:"0.06em", cursor:"pointer", transition:"all 0.2s",
            display:"flex", flexDirection:"column", alignItems:"center", gap:3,
          }}>
            <span style={{ fontSize:"0.95rem" }}>{t.icon}</span>
            {t.label}
          </button>
        ))}
      </div>

      {/* Tool Sub-Nav */}
      <div style={{ display:"flex", gap:6, padding:"0.65rem 1.2rem", overflowX:"auto", borderBottom:"1px solid var(--border)", scrollbarWidth:"none" }}>
        {currentTab.tools.map(t => (
          <button key={t.key} onClick={() => setActiveTool(t.key)} style={{
            flexShrink:0, padding:"0.32rem 0.8rem", borderRadius:20,
            border:`1px solid ${activeTool===t.key?"var(--cyan)":"var(--border2)"}`,
            background: activeTool===t.key ? "rgba(0,180,216,0.15)" : "var(--bg2)",
            color: activeTool===t.key ? "var(--cyan)" : "var(--text2)",
            fontSize:"0.7rem", fontFamily:"'Exo 2',sans-serif",
            cursor:"pointer", transition:"all 0.2s",
            display:"flex", alignItems:"center", gap:5,
          }}>
            <span>{t.icon}</span>{t.label}
          </button>
        ))}
      </div>

      {/* Tool Content */}
      <div style={{ flex:1, overflowY:"auto", padding:"1rem 1.2rem 2rem" }}>
        <ToolComponent />
      </div>

    </div>
  );
}
