// ─── SHARED UI ────────────────────────────────────────────────────────────────

function Card({ children, style }) {
  return (
    <div style={{ background:"#111", border:"1px solid #1f1f1f", borderRadius:8, padding:"14px 16px", marginBottom:10, ...(style||{}) }}>
      {children}
    </div>
  );
}

function SectionHeader({ icon, title, subtitle }) {
  return (
    <div style={{ display:"flex", alignItems:"center", gap:10, marginBottom:20, paddingBottom:10, borderBottom:"1px solid #1f1f1f" }}>
      <span style={{ fontSize:22 }}>{icon}</span>
      <div>
        <div style={{ fontSize:15, fontWeight:700, color:"#fff", letterSpacing:2, textTransform:"uppercase" }}>{title}</div>
        {subtitle && <div style={{ fontSize:11, color:"#555", marginTop:2 }}>{subtitle}</div>}
      </div>
    </div>
  );
}

function Lbl({ children }) {
  return <div style={{ fontSize:10, color:"#666", letterSpacing:1, marginBottom:4, marginTop:8 }}>{children}</div>;
}

function Inp({ value, onChange, placeholder, type, style }) {
  return (
    <input
      type={type||"text"}
      value={value}
      onChange={onChange}
      placeholder={placeholder}
      style={{ width:"100%", background:"#0d0d0d", border:"1px solid #2a2a2a", borderRadius:6, padding:"8px 12px", color:"#e5e5e5", fontFamily:"'IBM Plex Mono',monospace", fontSize:12, boxSizing:"border-box", outline:"none", ...(style||{}) }}
    />
  );
}

function Sel({ value, onChange, children, style }) {
  return (
    <select
      value={value}
      onChange={onChange}
      style={{ width:"100%", background:"#0d0d0d", border:"1px solid #2a2a2a", borderRadius:6, padding:"8px 12px", color:"#e5e5e5", fontFamily:"'IBM Plex Mono',monospace", fontSize:12, outline:"none", cursor:"pointer", ...(style||{}) }}
    >
      {children}
    </select>
  );
}

function Btn({ children, onClick, color, style }) {
  var c = color || "#dc2626";
  return (
    <button
      onClick={onClick}
      style={{ background:c, color:"#fff", border:"none", borderRadius:6, padding:"8px 16px", fontFamily:"'IBM Plex Mono',monospace", fontSize:11, fontWeight:700, letterSpacing:1, cursor:"pointer", ...(style||{}) }}
    >
      {children}
    </button>
  );
}

function Row({ label, value, color }) {
  return (
    <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", padding:"6px 0", borderBottom:"1px solid #161616" }}>
      <span style={{ fontSize:11, color:"#666" }}>{label}</span>
      <span style={{ fontSize:13, fontWeight:700, color:color||"#e5e5e5", fontFamily:"'IBM Plex Mono',monospace" }}>{value}</span>
    </div>
  );
}

function Tag({ children, color }) {
  var c = color || "#dc2626";
  return (
    <span style={{ display:"inline-block", background:c+"22", border:"1px solid "+c+"66", color:c, borderRadius:4, padding:"1px 7px", fontSize:10, fontWeight:700, marginRight:6, marginBottom:4 }}>
      {children}
    </span>
  );
}

var fmt = function(n, d) {
  var dec = (d === undefined) ? 2 : d;
  if (n === null || n === undefined || isNaN(Number(n))) return "--";
  return Number(n).toLocaleString("en-US", { minimumFractionDigits:dec, maximumFractionDigits:dec });
};

// ─── TOOL: CURRENCY CONVERTER ─────────────────────────────────────────────────

function CurrencyConverter() {
  var [amount, setAmount] = useState("1000");
  var [from, setFrom] = useState("USD");
  var [to, setTo] = useState("PHP");
  var [rate, setRate] = useState(null);
  var [loading, setLoading] = useState(false);
  var [manual, setManual] = useState("");
  var [useManual, setUseManual] = useState(false);
  var [updated, setUpdated] = useState("");

  var fetchRate = function(f, t) {
    setLoading(true);
    fetch("https://api.exchangerate-api.com/v4/latest/" + f)
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data && data.rates && data.rates[t]) {
          setRate(data.rates[t]);
          setUpdated(new Date().toLocaleTimeString());
        }
        setLoading(false);
      })
      .catch(function() { setLoading(false); });
  };

  useEffect(function() {
    if (!useManual) fetchRate(from, to);
  }, [from, to, useManual]);

  var activeRate = useManual ? parseFloat(manual) : rate;
  var amt = parseFloat(amount);
  var converted = (activeRate && !isNaN(amt)) ? amt * activeRate : null;
  var fromC = CURRENCIES.find(function(c) { return c.code === from; }) || {};
  var toC   = CURRENCIES.find(function(c) { return c.code === to; })   || {};

  return (
    <div>
      <SectionHeader icon="💱" title="Currency Converter" subtitle="Live rates via ExchangeRate-API" />
      <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:10, marginBottom:10 }}>
        <div>
          <Lbl>FROM</Lbl>
          <Sel value={from} onChange={function(e){setFrom(e.target.value);}}>
            {CURRENCIES.map(function(c){return <option key={c.code} value={c.code}>{c.flag} {c.code} - {c.name}</option>;})}
          </Sel>
        </div>
        <div>
          <Lbl>TO</Lbl>
          <Sel value={to} onChange={function(e){setTo(e.target.value);}}>
            {CURRENCIES.map(function(c){return <option key={c.code} value={c.code}>{c.flag} {c.code} - {c.name}</option>;})}
          </Sel>
        </div>
      </div>
      <Lbl>AMOUNT ({fromC.symbol || from})</Lbl>
      <Inp type="number" value={amount} onChange={function(e){setAmount(e.target.value);}} placeholder="1000" />
      <div style={{ display:"flex", alignItems:"center", gap:12, marginTop:10, flexWrap:"wrap" }}>
        <label style={{ display:"flex", alignItems:"center", gap:6, fontSize:11, color:"#888", cursor:"pointer" }}>
          <input type="checkbox" checked={useManual} onChange={function(e){setUseManual(e.target.checked);}} />
          Manual rate
        </label>
        {useManual ? (
          <Inp type="number" value={manual} onChange={function(e){setManual(e.target.value);}} placeholder="e.g. 56.50" style={{ width:140 }} />
        ) : (
          <Btn onClick={function(){fetchRate(from,to);}} color="#1f2937" style={{ border:"1px solid #374151", fontSize:11 }}>
            {loading ? "..." : "REFRESH"}
          </Btn>
        )}
        {updated && !useManual && <span style={{ fontSize:10, color:"#444" }}>Updated {updated}</span>}
      </div>
      {converted !== null && activeRate && (
        <Card style={{ marginTop:12, borderColor:"#1a2a1a" }}>
          <Row label={fmt(amount,2) + " " + from + " ="} value={(toC.symbol||to) + " " + fmt(converted,2) + " " + to} color="#4ade80" />
          <Row label="Exchange rate" value={"1 " + from + " = " + fmt(activeRate,4) + " " + to} />
          <Row label="Reverse rate"  value={"1 " + to + " = " + fmt(1/activeRate,4) + " " + from} />
        </Card>
      )}
    </div>
  );
}

