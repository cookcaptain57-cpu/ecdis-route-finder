// ─── TOOL 5: SAVINGS PLANNER ─────────────────────────────────────────────────
function SavingsPlanner() {
  const [income,   setIncome]   = useState("");
  const [currency, setCurrency] = useState("USD");
  const [expenses, setExpenses] = useState("");
  const [months,   setMonths]   = useState("9");
  const [existing, setExisting] = useState("0");
  const [goal,     setGoal]     = useState("");

  const inc = parseFloat(income)   || 0;
  const exp = parseFloat(expenses) || 0;
  const m   = parseFloat(months)   || 1;
  const ex  = parseFloat(existing) || 0;
  const g   = parseFloat(goal)     || 0;
  const cur = CURRENCIES.find(c => c.code === currency);

  const monthly   = inc - exp;
  const total     = monthly * m + ex;
  const rate      = inc > 0 ? (monthly / inc) * 100 : 0;
  const pct       = g > 0 ? Math.min(100, (total / g) * 100) : 0;
  const moToGoal  = g > 0 && monthly > 0 ? Math.ceil((g - ex) / monthly) : null;

  return (
    <div>
      <SectionHead icon="🏦" title="Savings Planner" sub="Track contract savings goals" />
      <div style={C.card}>
        <Grid2>
          <Field label="Currency">
            <select style={C.select} value={currency} onChange={e => setCurrency(e.target.value)}>
              {CURRENCIES.map(c => <option key={c.code} value={c.code}>{c.flag} {c.code}</option>)}
            </select>
          </Field>
          <Field label="Contract (months)">
            <input style={C.input} type="number" value={months} onChange={e => setMonths(e.target.value)} placeholder="9" />
          </Field>
        </Grid2>
        <Field label={`Monthly Income (${cur?.symbol})`}>
          <input style={C.input} type="number" value={income} onChange={e => setIncome(e.target.value)} placeholder="e.g. 2000" />
        </Field>
        <Field label={`Monthly Expenses / Allotment (${cur?.symbol})`}>
          <input style={C.input} type="number" value={expenses} onChange={e => setExpenses(e.target.value)} placeholder="e.g. 400" />
        </Field>
        <Grid2>
          <Field label={`Existing Savings (${cur?.symbol})`}>
            <input style={C.input} type="number" value={existing} onChange={e => setExisting(e.target.value)} placeholder="0" />
          </Field>
          <Field label={`Goal (${cur?.symbol}) optional`}>
            <input style={C.input} type="number" value={goal} onChange={e => setGoal(e.target.value)} placeholder="e.g. 20000" />
          </Field>
        </Grid2>
        {inc > 0 && (
          <>
