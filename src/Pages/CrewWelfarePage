                  <span style={{ color:"#555" }}>Website: </span><span style={{ color:"#60a5fa" }}>{c.website}</span>
                </div>
                <div style={{ marginTop:6, fontSize:10, color:"#555" }}>Languages: {c.lang}</div>
              </div>
            )}
          </Card>
        );
      })}
    </div>
  );
}

