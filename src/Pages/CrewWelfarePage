// ─── TOOL 1: CURRENCY CONVERTER ───────────────────────────────────────────────
function CurrencyConverter() {
  const [amount, setAmount] = useState(() => LS.get("curr_amount", "1000"));
  const [from, setFrom] = useState(() => LS.get("curr_from", "USD"));
  const [to, setTo] = useState(() => LS.get("curr_to", "PHP"));
  const [rate, setRate] = useState(null);
  const [loading, setLoading] = useState(false);
  const [lastFetch, setLastFetch] = useState(null);
  const [manualRate, setManualRate] = useState(() => LS.get("curr_manual", ""));
  const [useManual, setUseManual] = useState(false);

  useEffect(() => { LS.set("curr_amount", amount); }, [amount]);
  useEffect(() => { LS.set("curr_from", from); }, [from]);
  useEffect(() => { LS.set("curr_to", to); }, [to]);
  useEffect(() => { LS.set("curr_manual", manualRate); }, [manualRate]);

  const fetchRate = useCallback(async () => {
    setLoading(true);
    try {
      const res = await fetch(`https://api.exchangerate-api.com/v4/latest/${from}`);
      const data = await res.json();
      setRate(data.rates[to]);
      setLastFetch(new Date().toLocaleTimeString());
    } catch {
      setRate(null);
    }
    setLoading(false);
  }, [from, to]);

  useEffect(() => { if (!useManual) fetchRate(); }, [from, to, useManual]);

  const activeRate = useManual ? parseFloat(manualRate) : rate;
  const converted = activeRate ? parseFloat(amount) * activeRate : null;
  const fromCur = CURRENCIES.find(c => c.code === from);
  const toCur = CURRENCIES.find(c => c.code === to);

  return (
    <div>
      <SectionTitle icon="💱" title="Currency Converter" subtitle="Live rates via ExchangeRate-API · Manual override available" />
      <Card>
        <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12, marginBottom: 12 }}>
          <div>
            <Label>From</Label>
            <Select value={from} onChange={setFrom}>
              {CURRENCIES.map(c => <option key={c.code} value={c.code}>{c.flag} {c.code} — {c.name}</option>)}
            </Select>
          </div>
          <div>
            <Label>To</Label>
            <Select value={to} onChange={setTo}>
              {CURRENCIES.map(c => <option key={c.code} value={c.code}>{c.flag} {c.code} — {c.name}</option>)}
            </Select>
          </div>
        </div>
        <Label>Amount ({fromCur?.symbol})</Label>
        <Input type="number" value={amount} onChange={setAmount} placeholder="Enter amount" />

        <div style={{ display: "flex", alignItems: "center", gap: 10, marginTop: 12 }}>
          <label style={{ fontSize: "0.75rem", color: "var(--text2)", display: "flex", alignItems: "center", gap: 6, cursor: "pointer" }}>
            <input type="checkbox" checked={useManual} onChange={e => setUseManual(e.target.checked)} />
            Use manual rate
          </label>
          {useManual && (
            <Input value={manualRate} onChange={setManualRate} type="number" placeholder="e.g. 56.50" style={{ width: 140 }} />
          )}
          {!useManual && (
            <Btn small onClick={fetchRate}>{loading ? "..." : "↺ Refresh"}</Btn>
          )}
        </div>

        {activeRate && !isNaN(converted) && (
          <>
            <Result
              label={`${fmt(amount, 2)} ${from} =`}
              value={`${toCur?.symbol}${fmt(converted, 2)} ${to}`}
              color="var(--gold)"
            />
            <Result label="Exchange rate" value={`1 ${from} = ${fmt(activeRate, 4)} ${to}`} />
            <Result label="Reverse rate" value={`1 ${to} = ${fmt(1 / activeRate, 4)} ${from}`} />
            {lastFetch && !useManual && (
              <div style={{ fontSize: "0.65rem", color: "var(--text3)", textAlign: "right", marginTop: 6 }}>
                Last updated: {lastFetch}
              </div>
            )}
          </>
        )}
      </Card>
    </div>
  );
}

// ─── TOOL 2: WAGE CALCULATOR ──────────────────────────────────────────────────
function WageCalculator() {
  const [basic, setBasic] = useState(() => LS.get("wage_basic", ""));
  const [currency, setCurrency] = useState(() => LS.get("wage_currency", "USD"));
  const [rank, setRank] = useState(() => LS.get("wage_rank", "Officer"));
  const [months, setMonths] = useState(() => LS.get("wage_months", "9"));

  useEffect(() => { LS.set("wage_basic", basic); }, [basic]);
  useEffect(() => { LS.set("wage_currency", currency); }, [currency]);
  useEffect(() => { LS.set("wage_rank", rank); }, [rank]);
  useEffect(() => { LS.set("wage_months", months); }, [months]);

  const b = parseFloat(basic) || 0;
  const m = parseFloat(months) || 0;
  const cur = CURRENCIES.find(c => c.code === currency);

  // Standard maritime breakdown
  const fixedOT = b * 0.25;
  const leaveWages = b * 0.0833 * m;
  const vacationPay = b * 0.0833;
  const total = b + fixedOT;
  const contractTotal = total * m;
  const annualGross = total * 12;

  return (
    <div>
      <SectionTitle icon="💵" title="Wage Calculator" subtitle="Basic wage breakdown per ITF/CBA standards" />
      <Card>
        <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12, marginBottom: 12 }}>
          <div>
            <Label>Rank / Position</Label>
            <Select value={rank} onChange={setRank}>
              {["Master","Chief Officer","2nd Officer","3rd Officer","Chief Engineer","2nd Engineer","3rd Engineer","4th Engineer","Bosun","AB Seaman","OS","Cook","Steward","Officer","Rating"].map(r => (
                <option key={r} value={r}>{r}</option>
              ))}
            </Select>
          </div>
          <div>
            <Label>Currency</Label>
            <Select value={currency} onChange={setCurrency}>
              {CURRENCIES.map(c => <option key={c.code} value={c.code}>{c.flag} {c.code}</option>)}
            </Select>
          </div>
        </div>
        <Label>Basic Monthly Wage ({cur?.symbol})</Label>
        <Input type="number" value={basic} onChange={setBasic} placeholder="e.g. 1800" />
        <div style={{ marginTop: 12 }}>
          <Label>Contract Length (months)</Label>
          <Input type="number" value={months} onChange={setMonths} placeholder="e.g. 9" min="1" max="24" />
        </div>

        {b > 0 && (
          <>
            <Result label="Basic Wage / month" value={`${cur?.symbol}${fmt(b)}`} />
            <Result label="Fixed OT (25% of basic)" value={`${cur?.symbol}${fmt(fixedOT)}`} />
            <Result label="Vacation Pay / month (1/12)" value={`${cur?.symbol}${fmt(vacationPay)}`} color="var(--green)" />
            <Result label="Total Monthly Package" value={`${cur?.symbol}${fmt(total)}`} color="var(--gold)" />
            {m > 0 && (
              <>
                <div style={{ height: 1, background: "var(--border)", margin: "10px 0" }} />
                <Result label={`Contract Total (${months} months)`} value={`${cur?.symbol}${fmt(contractTotal)}`} color="var(--gold)" />
                <Result label={`Leave Wages (${months} months)`} value={`${cur?.symbol}${fmt(leaveWages)}`} />
                <Result label="Annualised Gross (est.)" value={`${cur?.symbol}${fmt(annualGross)}`} color="var(--cyan)" />
              </>
            )}
          </>
        )}
      </Card>
    </div>
  );
}

// ─── TOOL 3: OVERTIME CALCULATOR ─────────────────────────────────────────────
function OvertimeCalculator() {
  const [basic, setBasic] = useState(() => LS.get("ot_basic", ""));
  const [currency, setCurrency] = useState(() => LS.get("ot_currency", "USD"));
  const [hoursWorked, setHoursWorked] = useState(() => LS.get("ot_hours", ""));
  const [regularHours, setRegularHours] = useState(() => LS.get("ot_regular", "208"));
  const [otRate, setOtRate] = useState(() => LS.get("ot_rate", "1.25"));

  useEffect(() => { LS.set("ot_basic", basic); }, [basic]);
  useEffect(() => { LS.set("ot_currency", currency); }, [currency]);
  useEffect(() => { LS.set("ot_hours", hoursWorked); }, [hoursWorked]);
  useEffect(() => { LS.set("ot_regular", regularHours); }, [regularHours]);
  useEffect(() => { LS.set("ot_rate", otRate); }, [otRate]);

  const b = parseFloat(basic) || 0;
  const hw = parseFloat(hoursWorked) || 0;
  const rh = parseFloat(regularHours) || 208;
  const or = parseFloat(otRate) || 1.25;
  const cur = CURRENCIES.find(c => c.code === currency);

  const hourlyRate = b / rh;
  const otHours = Math.max(0, hw - rh);
  const regularPay = Math.min(hw, rh) * hourlyRate;
  const otPay = otHours * hourlyRate * or;
  const totalPay = regularPay + otPay;

  return (
    <div>
      <SectionTitle icon="⏱️" title="Overtime Calculator" subtitle="MLC 2006 compliant · Customisable OT multiplier" />
      <Card>
        <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12, marginBottom: 12 }}>
          <div>
            <Label>Currency</Label>
            <Select value={currency} onChange={setCurrency}>
              {CURRENCIES.map(c => <option key={c.code} value={c.code}>{c.flag} {c.code}</option>)}
            </Select>
          </div>
          <div>
            <Label>OT Multiplier</Label>
            <Select value={otRate} onChange={setOtRate}>
              <option value="1.25">1.25× (Standard)</option>
              <option value="1.5">1.5× (Time & Half)</option>
              <option value="2.0">2.0× (Double)</option>
              <option value="1.0">1.0× (Flat rate)</option>
            </Select>
          </div>
        </div>
        <Label>Basic Monthly Wage ({cur?.symbol})</Label>
        <Input type="number" value={basic} onChange={setBasic} placeholder="e.g. 1800" />
        <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12, marginTop: 12 }}>
          <div>
            <Label>Regular Hours / Month</Label>
            <Input type="number" value={regularHours} onChange={setRegularHours} placeholder="208" />
          </div>
          <div>
            <Label>Actual Hours Worked</Label>
            <Input type="number" value={hoursWorked} onChange={setHoursWorked} placeholder="e.g. 240" />
          </div>
        </div>

        {b > 0 && hw > 0 && (
          <>
            <Result label="Hourly Rate" value={`${cur?.symbol}${fmt(hourlyRate, 3)}/hr`} />
            <Result label={`Regular Pay (${Math.min(hw, rh)} hrs)`} value={`${cur?.symbol}${fmt(regularPay)}`} />
            <Result label={`OT Hours`} value={`${fmt(otHours, 0)} hrs`} color={otHours > 0 ? "var(--gold)" : "var(--text2)"} />
            <Result label={`OT Pay (${or}×)`} value={`${cur?.symbol}${fmt(otPay)}`} color="var(--gold)" />
            <Result label="Total Pay" value={`${cur?.symbol}${fmt(totalPay)}`} color="var(--green)" />
            {hw > 208 && (
              <div style={{ marginTop: 8, padding: "8px 12px", background: "rgba(240,165,0,0.08)", border: "1px solid var(--gold)33", borderRadius: 8, fontSize: "0.7rem", color: "var(--gold)" }}>
                ⚠️ MLC 2006: Maximum work hours = 14 hrs/day · 72 hrs/week. Verify compliance.
              </div>
            )}
          </>
        )}
      </Card>
    </div>
  );
}

