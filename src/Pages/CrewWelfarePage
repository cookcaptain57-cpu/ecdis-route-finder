const cardStyle = {
  background:"var(--card)", border:"1px solid var(--border)",
  borderRadius:14, padding:"1.1rem", marginBottom:"1rem",
};

const labelStyle = {
  fontSize:"0.67rem", color:"var(--text2)", textTransform:"uppercase",
  letterSpacing:"0.1em", marginBottom:5, display:"block",
  fontFamily:"'Orbitron',monospace",
};

function Field({ label, children }) {
  return (
    <div style={{ marginBottom:10 }}>
      <label style={labelStyle}>{label}</label>
      {children}
    </div>
  );
}

function Row({ label, value, color }) {
  return (
    <div style={{ background:"var(--bg)", border:"1px solid " + (color || "var(--cyan)") + "33",
      borderRadius:10, padding:"0.65rem 1rem", marginTop:7,
      display:"flex", justifyContent:"space-between", alignItems:"center" }}>
      <span style={{ fontSize:"0.72rem", color:"var(--text2)" }}>{label}</span>
      <span style={{ fontFamily:"'Orbitron',monospace", fontSize:"0.86rem",
        color: color || "var(--cyan)", fontWeight:700 }}>{value}</span>
    </div>
  );
}

function Btn({ children, onClick, color, small, style }) {
  const c = color || "var(--cyan)";
  return (
    <button onClick={onClick} style={{
      background: c + "18", border:"1px solid " + c, borderRadius:8, color:c,
      cursor:"pointer", padding: small ? "0.3rem 0.7rem" : "0.5rem 1rem",
      fontSize: small ? "0.68rem" : "0.78rem",
      fontFamily:"'Orbitron',monospace", letterSpacing:"0.05em",
      transition:"all 0.2s", ...(style || {}),
    }}>{children}</button>
  );
}

function Head({ icon, title, sub }) {
  return (
    <div style={{ marginBottom:"1rem" }}>
      <div style={{ display:"flex", alignItems:"center", gap:9, marginBottom:3 }}>
        <span style={{ fontSize:"1.2rem" }}>{icon}</span>
        <span style={{ fontFamily:"'Orbitron',monospace", fontSize:"0.86rem",
          fontWeight:700, color:"var(--cyan)" }}>{title}</span>
      </div>
      {sub && <div style={{ fontSize:"0.68rem", color:"var(--text2)", paddingLeft:32 }}>{sub}</div>}
    </div>
  );
}

function G2({ children }) {
  return <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:10, marginBottom:10 }}>{children}</div>;
}

const f = (n, d) => {
  const dec = d === undefined ? 2 : d;
  if (n === null || n === undefined || isNaN(Number(n))) return "—";
  return Number(n).toLocaleString("en-US", { minimumFractionDigits:dec, maximumFractionDigits:dec });
};

// ─── TOOL: CURRENCY CONVERTER ─────────────────────────────────────────────────
function CurrencyConverter() {
  const [amount,    setAmount]    = useState("1000");
  const [from,      setFrom]      = useState("USD");
  const [to,        setTo]        = useState("PHP");
  const [rate,      setRate]      = useState(null);
  const [loading,   setLoading]   = useState(false);
  const [manual,    setManual]    = useState("");
  const [useManual, setUseManual] = useState(false);
  const [updated,   setUpdated]   = useState("");

  const fetchRate = async (f, t) => {
    setLoading(true);
    try {
      const res  = await fetch("https://api.exchangerate-api.com/v4/latest/" + f);
      const data = await res.json();
      if (data && data.rates && data.rates[t]) {
        setRate(data.rates[t]);
        setUpdated(new Date().toLocaleTimeString());
      }
    } catch { /* silent fail */ }
    setLoading(false);
  };

  useEffect(() => { if (!useManual) fetchRate(from, to); }, [from, to, useManual]);

  const activeRate = useManual ? parseFloat(manual) : rate;
  const amt        = parseFloat(amount);
  const converted  = activeRate && !isNaN(amt) ? amt * activeRate : null;
  const fromC      = CURRENCIES.find(c => c.code === from) || {};
  const toC        = CURRENCIES.find(c => c.code === to)   || {};

  return (
    <div>
      <Head icon="💱" title="Currency Converter" sub="Live rates · Manual override available" />
      <div style={cardStyle}>
        <G2>
          <Field label="From">
            <select style={inputStyle} value={from} onChange={e => setFrom(e.target.value)}>
              {CURRENCIES.map(c => <option key={c.code} value={c.code}>{c.flag} {c.code} — {c.name}</option>)}
            </select>
          </Field>
          <Field label="To">
            <select style={inputStyle} value={to} onChange={e => setTo(e.target.value)}>
              {CURRENCIES.map(c => <option key={c.code} value={c.code}>{c.flag} {c.code} — {c.name}</option>)}
            </select>
          </Field>
        </G2>
        <Field label={"Amount (" + (fromC.symbol || "") + ")"}>
          <input style={inputStyle} type="number" value={amount} onChange={e => setAmount(e.target.value)} placeholder="1000" />
        </Field>
        <div style={{ display:"flex", alignItems:"center", gap:10, marginTop:8, flexWrap:"wrap" }}>
          <label style={{ fontSize:"0.73rem", color:"var(--text2)", display:"flex", alignItems:"center", gap:6, cursor:"pointer" }}>
            <input type="checkbox" checked={useManual} onChange={e => setUseManual(e.target.checked)} />
            Manual rate
          </label>
          {useManual
            ? <input style={{ ...inputStyle, width:130 }} type="number" value={manual} onChange={e => setManual(e.target.value)} placeholder="e.g. 56.50" />
            : <Btn small onClick={() => fetchRate(from, to)}>{loading ? "..." : "Refresh"}</Btn>
          }
        </div>
        {converted !== null && activeRate && (
          <>
            <Row label={f(amount,2) + " " + from + " ="} value={(toC.symbol || "") + f(converted,2) + " " + to} color="var(--gold)" />
            <Row label="Rate"    value={"1 " + from + " = " + f(activeRate,4) + " " + to} />
            <Row label="Reverse" value={"1 " + to   + " = " + f(1/activeRate,4) + " " + from} />
            {updated && !useManual && <div style={{ fontSize:"0.62rem", color:"var(--text3)", textAlign:"right", marginTop:5 }}>Updated: {updated}</div>}
          </>
        )}
      </div>
    </div>
  );
}

