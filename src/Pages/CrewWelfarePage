            <Input type="date" value={joinDate} onChange={setJoinDate} />
          </div>
          <div>
            <Label>Contract Length (months)</Label>
            <Input type="number" value={contractMonths} onChange={setContractMonths} placeholder="9" />
          </div>
        </div>
        <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12, marginBottom: 12 }}>
          <div>
            <Label>Leave Ratio (leave:sea)</Label>
            <Select value={leaveRatio} onChange={setLeaveRatio}>
              {Object.keys(ratioMap).map(r => <option key={r} value={r}>{r}</option>)}
            </Select>
          </div>
          <div>
            <Label>Planned Leave Days</Label>
            <Input type="number" value={plannedLeave} onChange={setPlannedLeave} placeholder="30" />
          </div>
        </div>

        {cm > 0 && (
          <>
            <Result label="Sea Days" value={`${fmt(seaDays, 0)} days`} />
            <Result label={`Earned Leave (${leaveRatio} ratio)`} value={`${fmt(earnedLeaveDays, 0)} days`} color="var(--cyan)" />
            {leaveEndDate && <Result label="Contract End Date" value={leaveEndDate} color="var(--gold)" />}
            {nextSignOnDate && <Result label="Est. Next Sign-On" value={nextSignOnDate} color="var(--green)" />}
            <Result
              label="Leave Balance (after plan)"
              value={`${fmt(leaveBalance, 0)} days`}
              color={leaveBalance >= 0 ? "var(--green)" : "var(--red)"}
            />
          </>
        )}
      </Card>
    </div>
  );
}

// ─── TOOL 7: RELIEF DATE CALCULATOR ─────────────────────────────────────────
function ReliefDateCalculator() {
  const [joinDate, setJoinDate] = useState(() => LS.get("rel_join", ""));
  const [contractMin, setContractMin] = useState(() => LS.get("rel_min", "7"));
  const [contractMax, setContractMax] = useState(() => LS.get("rel_max", "11"));
  const [notes, setNotes] = useState(() => LS.get("rel_notes", ""));

  useEffect(() => { LS.set("rel_join", joinDate); LS.set("rel_min", contractMin); LS.set("rel_max", contractMax); LS.set("rel_notes", notes); }, [joinDate, contractMin, contractMax, notes]);

  const addMonths = (dateStr, months) => {
    if (!dateStr) return null;
    const d = new Date(dateStr);
    d.setMonth(d.getMonth() + months);
    return d;
  };

  const fmt2 = d => d ? d.toLocaleDateString("en-GB", { weekday: "short", day: "2-digit", month: "short", year: "numeric" }) : "—";
  const today = new Date();
  const minDate = addMonths(joinDate, parseFloat(contractMin) || 0);
  const maxDate = addMonths(joinDate, parseFloat(contractMax) || 0);

  const daysToMin = minDate ? Math.max(0, Math.ceil((minDate - today) / 86400000)) : null;
  const daysToMax = maxDate ? Math.max(0, Math.ceil((maxDate - today) / 86400000)) : null;
  const daysOnboard = joinDate ? Math.floor((today - new Date(joinDate)) / 86400000) : null;
  const inWindow = minDate && maxDate ? today >= minDate && today <= maxDate : false;

  return (
    <div>
      <SectionTitle icon="🔄" title="Relief Date Calculator" subtitle="Track your relief window and days remaining" />
      <Card>
        <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: 12, marginBottom: 12 }}>
          <div>
            <Label>Join Date</Label>
            <Input type="date" value={joinDate} onChange={setJoinDate} />
          </div>
          <div>
            <Label>Min Contract (mo)</Label>
            <Input type="number" value={contractMin} onChange={setContractMin} placeholder="7" />
          </div>
          <div>
            <Label>Max Contract (mo)</Label>
            <Input type="number" value={contractMax} onChange={setContractMax} placeholder="11" />
          </div>
        </div>

        {joinDate && daysOnboard !== null && (
          <>
            <Result label="Days Onboard So Far" value={`${daysOnboard} days`} color={daysOnboard > 200 ? "var(--red)" : "var(--text)"} />
            <Result label="Earliest Relief Date" value={fmt2(minDate)} color="var(--cyan)" />
            <Result label="Latest Relief Date" value={fmt2(maxDate)} color="var(--gold)" />

            {!inWindow && daysToMin !== null && daysToMin > 0 && (
              <Result label="Days Until Relief Window Opens" value={`${daysToMin} days`} color="var(--text2)" />
            )}
            {inWindow && (
              <>
                <div style={{ marginTop: 8, padding: "10px 14px", background: "rgba(0,200,150,0.1)", border: "1px solid var(--green)", borderRadius: 10, fontSize: "0.78rem", color: "var(--green)", textAlign: "center" }}>
                  ✅ You are currently within your relief window
                </div>
                {daysToMax !== null && <Result label="Days Until Max Contract" value={`${daysToMax} days`} color="var(--red)" />}
              </>
            )}
            {daysToMax === 0 && (
              <div style={{ marginTop: 8, padding: "10px 14px", background: "rgba(255,71,87,0.1)", border: "1px solid var(--red)", borderRadius: 10, fontSize: "0.78rem", color: "var(--red)", textAlign: "center" }}>
                ⚠️ Maximum contract duration reached — relief required
              </div>
            )}
          </>
        )}

        <div style={{ marginTop: 12 }}>
          <Label>Notes</Label>
          <textarea
            value={notes}
            onChange={e => setNotes(e.target.value)}
            placeholder="Port, vessel name, next assignment..."
            style={{
              width: "100%", minHeight: 60, background: "var(--bg2)", border: "1px solid var(--border2)",
              borderRadius: 8, padding: "0.55rem 0.8rem", color: "var(--text)", fontSize: "0.82rem",
              fontFamily: "'Exo 2', sans-serif", resize: "vertical", outline: "none",
            }}
          />
        </div>
      </Card>
    </div>
  );
}

// ─── TOOL 8: CONTRACT TRACKER ─────────────────────────────────────────────────
function ContractTracker() {
  const [contracts, setContracts] = useState(() => LS.get("ct_list", []));
