        <Input type="number" value={basic} onChange={setBasic} placeholder="e.g. 1800" />

        <div style={{ display: "flex", gap: 8, margin: "12px 0 8px" }}>
          {["pct", "fixed"].map(m => (
            <Btn key={m} small onClick={() => setMode(m)} color={mode === m ? "var(--cyan)" : "var(--text3)"}>
              {m === "pct" ? "By %" : "Fixed Amount"}
            </Btn>
          ))}
        </div>

        {mode === "pct" ? (
          <div>
            <Label>Allotment Percentage</Label>
            <div style={{ display: "flex", alignItems: "center", gap: 10 }}>
              <input type="range" min="0" max="100" value={pct} onChange={e => setPct(e.target.value)}
                style={{ flex: 1, accentColor: "var(--cyan)" }} />
              <span style={{ fontFamily: "'Orbitron', monospace", color: "var(--cyan)", minWidth: 42 }}>{pct}%</span>
            </div>
          </div>
        ) : (
          <div>
            <Label>Fixed Allotment Amount ({cur?.symbol})</Label>
            <Input type="number" value={fixedAmt} onChange={setFixedAmt} placeholder="e.g. 1400" />
          </div>
        )}

        <div style={{ marginTop: 12 }}>
          <Label>Conversion Rate (1 {currency} = ? {homeCurrency}) — optional</Label>
          <Input type="number" value={convRate} onChange={setConvRate} placeholder="Enter rate manually" />
        </div>

        {b > 0 && (
          <>
            <Result label="Allotment (to family)" value={`${cur?.symbol}${fmt(allotment)}`} color="var(--gold)" />
            <Result label="Retained onboard" value={`${cur?.symbol}${fmt(retained)}`} />
            <Result label="Allotment %" value={`${fmt((allotment / b) * 100, 1)}%`} color="var(--cyan)" />
            {homeAmt && (
