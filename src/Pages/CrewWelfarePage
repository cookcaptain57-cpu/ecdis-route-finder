// ─── TOOL 1: CURRENCY CONVERTER ───────────────────────────────────────────────
function CurrencyConverter() {
  const [amount, setAmount]     = useState("1000");
  const [from, setFrom]         = useState("USD");
  const [to, setTo]             = useState("PHP");
  const [rate, setRate]         = useState(null);
  const [loading, setLoading]   = useState(false);
  const [manualRate, setManual] = useState("");
  const [useManual, setUseManual] = useState(false);
  const [lastUpd, setLastUpd]   = useState("");

  const fetchRate = async (f, t) => {
    setLoading(true);
    try {
      const res = await fetch(`https://api.exchangerate-api.com/v4/latest/${f}`);
      const data = await res.json();
      if (data && data.rates && data.rates[t]) {
        setRate(data.rates[t]);
        setLastUpd(new Date().toLocaleTimeString());
      }
    } catch { setRate(null); }
    setLoading(false);
  };

  useEffect(() => { if (!useManual) fetchRate(from, to); }, [from, to, useManual]);

  const activeRate = useManual ? parseFloat(manualRate) : rate;
  const converted  = activeRate && !isNaN(parseFloat(amount)) ? parseFloat(amount) * activeRate : null;
  const fromC = CURRENCIES.find(c => c.code === from);
  const toC   = CURRENCIES.find(c => c.code === to);

  return (
    <div>
      <SectionHead icon="💱" title="Currency Converter" sub="Live rates · Manual override available" />
      <div style={C.card}>
        <Grid2>
          <Field label="From">
            <select style={C.select} value={from} onChange={e => setFrom(e.target.value)}>
              {CURRENCIES.map(c => <option key={c.code} value={c.code}>{c.flag} {c.code} — {c.name}</option>)}
            </select>
          </Field>
          <Field label="To">
            <select style={C.select} value={to} onChange={e => setTo(e.target.value)}>
              {CURRENCIES.map(c => <option key={c.code} value={c.code}>{c.flag} {c.code} — {c.name}</option>)}
            </select>
          </Field>
        </Grid2>
        <Field label={`Amount (${fromC?.symbol || ""})`}>
          <input style={C.input} type="number" value={amount} onChange={e => setAmount(e.target.value)} placeholder="1000" />
        </Field>
        <div style={{ display:"flex", alignItems:"center", gap:10, marginTop:8, flexWrap:"wrap" }}>
          <label style={{ fontSize:"0.74rem", color:"var(--text2)", display:"flex", alignItems:"center", gap:6, cursor:"pointer" }}>
            <input type="checkbox" checked={useManual} onChange={e => setUseManual(e.target.checked)} />
            Manual rate
          </label>
          {useManual
            ? <input style={{ ...C.input, width:130 }} type="number" value={manualRate} onChange={e => setManual(e.target.value)} placeholder="e.g. 56.50" />
            : <Btn small onClick={() => fetchRate(from, to)}>{loading ? "..." : "↺ Refresh"}</Btn>
          }
        </div>
        {converted !== null && activeRate && (
          <>
            <Row label={`${fmt(amount,2)} ${from} =`} value={`${toC?.symbol}${fmt(converted,2)} ${to}`} color="var(--gold)" />
            <Row label="Rate" value={`1 ${from} = ${fmt(activeRate,4)} ${to}`} />
            <Row label="Reverse" value={`1 ${to} = ${fmt(1/activeRate,4)} ${from}`} />
            {lastUpd && !useManual && <div style={{ fontSize:"0.63rem", color:"var(--text3)", textAlign:"right", marginTop:5 }}>Updated: {lastUpd}</div>}
          </>
        )}
      </div>
    </div>
  );
}

