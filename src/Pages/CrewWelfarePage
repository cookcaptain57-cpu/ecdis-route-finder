// ─── TOOL 3: OVERTIME CALCULATOR ─────────────────────────────────────────────
function OvertimeCalculator() {
  const [basic, setBasic]       = useState("");
  const [currency, setCurrency] = useState("USD");
  const [worked, setWorked]     = useState("");
  const [regular, setRegular]   = useState("208");
  const [mult, setMult]         = useState("1.25");

  const b  = parseFloat(basic)   || 0;
  const hw = parseFloat(worked)  || 0;
  const rh = parseFloat(regular) || 208;
  const or = parseFloat(mult)    || 1.25;
  const cur = CURRENCIES.find(c => c.code === currency);

  const hrRate    = b / rh;
  const otHours   = Math.max(0, hw - rh);
  const regPay    = Math.min(hw, rh) * hrRate;
  const otPay     = otHours * hrRate * or;
  const totalPay  = regPay + otPay;

  return (
    <div>
      <SectionHead icon="⏱️" title="Overtime Calculator" sub="MLC 2006 compliant" />
      <div style={C.card}>
        <Grid2>
          <Field label="Currency">
            <select style={C.select} value={currency} onChange={e => setCurrency(e.target.value)}>
              {CURRENCIES.map(c => <option key={c.code} value={c.code}>{c.flag} {c.code}</option>)}
            </select>
          </Field>
          <Field label="OT Multiplier">
            <select style={C.select} value={mult} onChange={e => setMult(e.target.value)}>
              <option value="1.25">1.25× Standard</option>
              <option value="1.5">1.5× Time & Half</option>
              <option value="2.0">2.0× Double</option>
              <option value="1.0">1.0× Flat</option>
            </select>
          </Field>
        </Grid2>
        <Field label={`Basic Monthly Wage (${cur?.symbol})`}>
          <input style={C.input} type="number" value={basic} onChange={e => setBasic(e.target.value)} placeholder="e.g. 1800" />
        </Field>
        <Grid2>
          <Field label="Regular Hours / Month">
            <input style={C.input} type="number" value={regular} onChange={e => setRegular(e.target.value)} placeholder="208" />
          </Field>
          <Field label="Actual Hours Worked">
            <input style={C.input} type="number" value={worked} onChange={e => setWorked(e.target.value)} placeholder="e.g. 240" />
          </Field>
        </Grid2>
        {b > 0 && hw > 0 && (
          <>
            <Row label="Hourly Rate"          value={`${cur?.symbol}${fmt(hrRate,3)}/hr`} />
            <Row label={`OT Hours`}           value={`${fmt(otHours,0)} hrs`} color={otHours>0?"var(--gold)":"var(--text2)"} />
            <Row label={`OT Pay (${or}×)`}    value={`${cur?.symbol}${fmt(otPay)}`} color="var(--gold)" />
            <Row label="Total Pay"            value={`${cur?.symbol}${fmt(totalPay)}`} color="var(--green)" />
            {hw > 208 && (
              <div style={{ marginTop:8, padding:"8px 12px", background:"rgba(240,165,0,0.08)", border:"1px solid rgba(240,165,0,0.3)", borderRadius:8, fontSize:"0.7rem", color:"var(--gold)" }}>
                ⚠️ MLC 2006: Max 14 hrs/day · 72 hrs/week. Verify compliance.
              </div>
            )}
          </>
        )}
      </div>
    </div>
  );
}

// ─── TOOL 4: ALLOTMENT CALCULATOR ────────────────────────────────────────────
