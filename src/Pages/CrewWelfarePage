  );
}

// ─── TOOL 10: FATIGUE ASSESSMENT ─────────────────────────────────────────────
function FatigueAssessment() {
  const [answers, setAnswers] = useState(() => LS.get("fatigue_answers", {}));

  useEffect(() => { LS.set("fatigue_answers", answers); }, [answers]);

  const setAnswer = (id, val) => setAnswers(prev => ({ ...prev, [id]: val }));

  const allAnswered = FATIGUE_QUESTIONS.every(q => answers[q.id] !== undefined);

  const calcFatigue = () => {
    let total = 0;
    FATIGUE_QUESTIONS.forEach(q => {
      const val = answers[q.id];
      if (q.type === "select" && q.weights) {
        total += q.weights[val] ?? 0;
      } else if (q.type === "scale") {
        total += parseInt(val) || 0;
      }
    });
    return total;
  };

  const score = allAnswered ? calcFatigue() : null;
  const maxScore = 30;

  const riskLevel = score === null ? null :
    score <= 6 ? { label: "Low Fatigue — Fit for Duty", color: "var(--green)", advice: "Current levels appear manageable. Maintain regular rest patterns." } :
    score <= 14 ? { label: "Moderate Fatigue — Monitor", color: "var(--gold)", advice: "Plan additional rest time. Avoid complex navigation tasks if possible." } :
    score <= 22 ? { label: "High Fatigue — Caution", color: "var(--red)", advice: "Inform your OOW/Master. Avoid solo watchkeeping. Rest is required." } :
    { label: "Critical Fatigue — Not Fit for Duty", color: "var(--red)", advice: "Do not stand watch. Notify Master immediately. Rest is mandatory per MLC 2006." };

  return (
    <div>
      <SectionTitle icon="😴" title="Fatigue Assessment" subtitle="MLC 2006 / STCW rest hour awareness tool" />

      <Card>
        <div style={{ fontSize: "0.72rem", color: "var(--text2)", marginBottom: 14, lineHeight: 1.6 }}>
          Answer honestly. Results are stored <strong style={{ color: "var(--text)" }}>locally only</strong> and are for personal awareness, not official reporting.
        </div>

        {FATIGUE_QUESTIONS.map((q, i) => (
          <div key={q.id} style={{ marginBottom: 16, paddingBottom: 16, borderBottom: i < FATIGUE_QUESTIONS.length - 1 ? "1px solid var(--border)" : "none" }}>
            <div style={{ fontSize: "0.82rem", color: "var(--text)", marginBottom: 8 }}>
              <span style={{ color: "var(--text3)", marginRight: 6 }}>{i + 1}.</span>{q.text}
            </div>
            {q.type === "select" && (
              <div style={{ display: "flex", gap: 6, flexWrap: "wrap" }}>
                {q.options.map((opt, idx) => (
                  <button key={idx} onClick={() => setAnswer(q.id, idx)}
                    style={{
                      padding: "5px 10px", borderRadius: 6, fontSize: "0.7rem", cursor: "pointer", transition: "all 0.15s",
                      border: `1px solid ${answers[q.id] === idx ? "var(--cyan)" : "var(--border2)"}`,
                      background: answers[q.id] === idx ? "rgba(0,180,216,0.15)" : "var(--bg2)",
                      color: answers[q.id] === idx ? "var(--cyan)" : "var(--text2)",
                    }}
                  >{opt}</button>
                ))}
              </div>
            )}
            {q.type === "scale" && (
              <div>
                <div style={{ display: "flex", justifyContent: "space-between", fontSize: "0.65rem", color: "var(--text3)", marginBottom: 4 }}>
                  <span>{q.label?.split("→")[0]?.trim()}</span>
                  <span>{q.label?.split("→")[1]?.trim()}</span>
                </div>
                <div style={{ display: "flex", gap: 5 }}>
                  {[0, 1, 2, 3, 4].map(v => (
                    <button key={v} onClick={() => setAnswer(q.id, v)}
                      style={{
                        flex: 1, padding: "6px 0", borderRadius: 6, fontSize: "0.75rem", cursor: "pointer", transition: "all 0.15s",
                        border: `1px solid ${answers[q.id] === v ? "var(--cyan)" : "var(--border2)"}`,
                        background: answers[q.id] === v ? "rgba(0,180,216,0.2)" : "var(--bg2)",
                        color: answers[q.id] === v ? "var(--cyan)" : "var(--text2)",
                      }}
                    >{v}</button>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}

        {allAnswered && riskLevel && (
          <div style={{ marginTop: 16, padding: "14px 16px", background: `${riskLevel.color}15`, border: `1px solid ${riskLevel.color}55`, borderRadius: 12 }}>
            <div style={{ display: "flex", justifyContent: "space-between", marginBottom: 8 }}>
              <span style={{ fontFamily: "'Orbitron', monospace", fontSize: "0.82rem", color: riskLevel.color }}>{riskLevel.label}</span>
              <span style={{ fontFamily: "'Orbitron', monospace", fontSize: "0.8rem", color: riskLevel.color }}>{score}/{maxScore}</span>
            </div>
            <div style={{ height: 8, background: "var(--bg)", borderRadius: 4, overflow: "hidden", marginBottom: 10 }}>
              <div style={{ height: "100%", width: `${(score / maxScore) * 100}%`, background: riskLevel.color, borderRadius: 4 }} />
            </div>
            <div style={{ fontSize: "0.75rem", color: "var(--text2)", lineHeight: 1.6 }}>{riskLevel.advice}</div>
          </div>
        )}

        <div style={{ marginTop: 12 }}>
          <Btn small color="var(--text3)" onClick={() => setAnswers({})}>↺ Reset</Btn>
        </div>
      </Card>
    </div>
  );
}

