            </div>
            <div style={{ height: 8, background: "var(--bg)", borderRadius: 4, overflow: "hidden" }}>
              <div style={{ height: "100%", width: `${(score / maxScore) * 100}%`, background: riskLevel.color, borderRadius: 4 }} />
