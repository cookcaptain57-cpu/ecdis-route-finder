// ── SHARED ────────────────────────────────────────────────────────────────────
const CURR = [
  {code:"USD",name:"US Dollar",sym:"$",flag:"🇺🇸"},{code:"EUR",name:"Euro",sym:"€",flag:"🇪🇺"},
  {code:"GBP",name:"British Pound",sym:"£",flag:"🇬🇧"},{code:"PHP",name:"Philippine Peso",sym:"₱",flag:"🇵🇭"},
  {code:"INR",name:"Indian Rupee",sym:"₹",flag:"🇮🇳"},{code:"IDR",name:"Indonesian Rupiah",sym:"Rp",flag:"🇮🇩"},
  {code:"MYR",name:"Malaysian Ringgit",sym:"RM",flag:"🇲🇾"},{code:"SGD",name:"Singapore Dollar",sym:"S$",flag:"🇸🇬"},
  {code:"CNY",name:"Chinese Yuan",sym:"¥",flag:"🇨🇳"},{code:"JPY",name:"Japanese Yen",sym:"¥",flag:"🇯🇵"},
  {code:"KRW",name:"South Korean Won",sym:"₩",flag:"🇰🇷"},{code:"AUD",name:"Australian Dollar",sym:"A$",flag:"🇦🇺"},
  {code:"CAD",name:"Canadian Dollar",sym:"C$",flag:"🇨🇦"},{code:"AED",name:"UAE Dirham",sym:"AED",flag:"🇦🇪"},
  {code:"BRL",name:"Brazilian Real",sym:"R$",flag:"🇧🇷"},{code:"ZAR",name:"South African Rand",sym:"R",flag:"🇿🇦"},
  {code:"NGN",name:"Nigerian Naira",sym:"NGN",flag:"🇳🇬"},{code:"NOK",name:"Norwegian Krone",sym:"kr",flag:"🇳🇴"},
  {code:"SEK",name:"Swedish Krona",sym:"kr",flag:"🇸🇪"},{code:"CHF",name:"Swiss Franc",sym:"Fr",flag:"🇨🇭"},
  {code:"HKD",name:"Hong Kong Dollar",sym:"HK$",flag:"🇭🇰"},{code:"UAH",name:"Ukrainian Hryvnia",sym:"UAH",flag:"🇺🇦"},
  {code:"PLN",name:"Polish Zloty",sym:"zl",flag:"🇵🇱"},{code:"TRY",name:"Turkish Lira",sym:"TRY",flag:"🇹🇷"},
];

function f(n, d=2) {
  if (n===null||n===undefined||isNaN(Number(n))) return "--";
  return Number(n).toLocaleString("en-US",{minimumFractionDigits:d,maximumFractionDigits:d});
}

function Box({children,style={}}) {
  return <div style={{background:"#111",border:"1px solid #1f1f1f",borderRadius:8,padding:"14px 16px",marginBottom:10,...style}}>{children}</div>;
}
function Lbl({children}) {
  return <div style={{fontSize:10,color:"#666",letterSpacing:1,marginBottom:4,marginTop:8}}>{children}</div>;
}
function Row({label,value,color}) {
  return (
    <div style={{display:"flex",justifyContent:"space-between",padding:"6px 0",borderBottom:"1px solid #161616"}}>
      <span style={{fontSize:11,color:"#666"}}>{label}</span>
      <span style={{fontSize:13,fontWeight:700,color:color||"#e5e5e5",fontFamily:"monospace"}}>{value}</span>
    </div>
  );
}
function Inp({value,onChange,placeholder,type="text",style={}}) {
  return <input type={type} value={value} onChange={onChange} placeholder={placeholder}
    style={{width:"100%",background:"#0d0d0d",border:"1px solid #2a2a2a",borderRadius:6,padding:"8px 12px",
      color:"#e5e5e5",fontSize:12,boxSizing:"border-box",outline:"none",...style}} />;
}
function Sel({value,onChange,children,style={}}) {
  return <select value={value} onChange={onChange}
    style={{width:"100%",background:"#0d0d0d",border:"1px solid #2a2a2a",borderRadius:6,padding:"8px 12px",
      color:"#e5e5e5",fontSize:12,outline:"none",cursor:"pointer",...style}}>{children}</select>;
}
function CurrSel({value,onChange}) {
  return <Sel value={value} onChange={e=>onChange(e.target.value)}>
    {CURR.map(c=><option key={c.code} value={c.code}>{c.flag} {c.code} - {c.name}</option>)}
  </Sel>;
}
function Head({icon,title,sub}) {
  return (
    <div style={{marginBottom:20,paddingBottom:10,borderBottom:"1px solid #1f1f1f"}}>
      <div style={{display:"flex",alignItems:"center",gap:10}}>
        <span style={{fontSize:20}}>{icon}</span>
        <div style={{fontSize:14,fontWeight:700,color:"#fff",letterSpacing:2,textTransform:"uppercase"}}>{title}</div>
      </div>
      {sub && <div style={{fontSize:11,color:"#555",marginTop:4,paddingLeft:30}}>{sub}</div>}
    </div>
  );
}
function G2({children}) {
  return <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:10,marginBottom:4}}>{children}</div>;
}

// ── CURRENCY ──────────────────────────────────────────────────────────────────
function CurrencyTool() {
  const [amt,setAmt]=useState("1000");
  const [from,setFrom]=useState("USD");
  const [to,setTo]=useState("PHP");
  const [rate,setRate]=useState(null);
  const [loading,setLoading]=useState(false);
  const [manual,setManual]=useState("");
  const [useManual,setUseManual]=useState(false);
  const [updated,setUpdated]=useState("");

  const fetch2=(f,t)=>{
    setLoading(true);
    fetch("https://api.exchangerate-api.com/v4/latest/"+f)
      .then(r=>r.json()).then(d=>{
        if(d&&d.rates&&d.rates[t]){setRate(d.rates[t]);setUpdated(new Date().toLocaleTimeString());}
        setLoading(false);
      }).catch(()=>setLoading(false));
  };

  useEffect(()=>{if(!useManual)fetch2(from,to);},[from,to,useManual]);

  const ar=useManual?parseFloat(manual):rate;
  const a=parseFloat(amt);
  const conv=(ar&&!isNaN(a))?a*ar:null;
  const fc=CURR.find(c=>c.code===from)||{};
  const tc=CURR.find(c=>c.code===to)||{};

  return (
    <div>
      <Head icon="💱" title="Currency Converter" sub="Live rates via ExchangeRate-API" />
      <G2>
        <div><Lbl>FROM</Lbl><CurrSel value={from} onChange={setFrom}/></div>
        <div><Lbl>TO</Lbl><CurrSel value={to} onChange={setTo}/></div>
      </G2>
      <Lbl>AMOUNT ({fc.sym||from})</Lbl>
      <Inp type="number" value={amt} onChange={e=>setAmt(e.target.value)} placeholder="1000"/>
      <div style={{display:"flex",alignItems:"center",gap:12,marginTop:10,flexWrap:"wrap"}}>
        <label style={{display:"flex",alignItems:"center",gap:6,fontSize:11,color:"#888",cursor:"pointer"}}>
          <input type="checkbox" checked={useManual} onChange={e=>setUseManual(e.target.checked)}/>
          Manual rate
        </label>
        {useManual
          ? <Inp type="number" value={manual} onChange={e=>setManual(e.target.value)} placeholder="e.g. 56.50" style={{width:140}}/>
          : <button onClick={()=>fetch2(from,to)} style={{background:"#1f2937",border:"1px solid #374151",color:"#aaa",borderRadius:6,padding:"6px 14px",fontSize:11,cursor:"pointer"}}>{loading?"...":"REFRESH"}</button>
        }
        {updated&&!useManual&&<span style={{fontSize:10,color:"#444"}}>Updated {updated}</span>}
      </div>
      {conv!==null&&ar&&(
        <Box style={{marginTop:12,borderColor:"#1a2a1a"}}>
          <Row label={f(amt,2)+" "+from+" ="} value={(tc.sym||to)+" "+f(conv,2)+" "+to} color="#4ade80"/>
          <Row label="Rate"    value={"1 "+from+" = "+f(ar,4)+" "+to}/>
          <Row label="Reverse" value={"1 "+to+" = "+f(1/ar,4)+" "+from}/>
        </Box>
      )}
    </div>
  );
}

