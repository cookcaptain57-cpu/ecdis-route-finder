// ─── SHARED UI ────────────────────────────────────────────────────────────────
const inputStyle = {
  width:"100%", background:"var(--bg2)", border:"1px solid var(--border2)",
  borderRadius:8, padding:"0.5rem 0.75rem", color:"var(--text)",
  fontSize:"0.85rem", fontFamily:"'Exo 2',sans-serif", outline:"none",
