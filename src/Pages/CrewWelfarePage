        <div>
          <Lbl>OT MULTIPLIER</Lbl>
          <Sel value={mult} onChange={function(e){setMult(e.target.value);}}>
            <option value="1.25">1.25x Standard</option>
            <option value="1.5">1.5x Time and Half</option>
            <option value="2.0">2.0x Double</option>
            <option value="1.0">1.0x Flat</option>
          </Sel>
        </div>
      </div>
      <Lbl>BASIC MONTHLY WAGE ({cur.symbol || currency})</Lbl>
      <Inp type="number" value={basic} onChange={function(e){setBasic(e.target.value);}} placeholder="e.g. 1800" />
      <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:10, marginTop:4 }}>
        <div>
          <Lbl>REGULAR HOURS / MONTH</Lbl>
          <Inp type="number" value={regular} onChange={function(e){setRegular(e.target.value);}} placeholder="208" />
        </div>
        <div>
          <Lbl>ACTUAL HOURS WORKED</Lbl>
          <Inp type="number" value={worked} onChange={function(e){setWorked(e.target.value);}} placeholder="e.g. 240" />
        </div>
      </div>
      {b > 0 && hw > 0 && (
        <Card style={{ marginTop:12, borderColor:"#2a1a00" }}>
          <Row label="Hourly Rate"              value={(cur.symbol||"")+fmt(hr,3)+" /hr"} />
          <Row label="OT Hours"                 value={fmt(oth,0)+" hrs"} color={oth>0?"#fbbf24":"#888"} />
          <Row label={"OT Pay ("+or+"x)"}       value={(cur.symbol||"")+fmt(otp)} color="#fbbf24" />
          <Row label="Total Pay"                value={(cur.symbol||"")+fmt(tot)} color="#4ade80" />
          {hw > 208 && (
            <div style={{ marginTop:8, padding:"8px 10px", background:"#1a0a00", borderRadius:6, fontSize:11, color:"#d97706" }}>
              MLC 2006: Max 14 hrs/day and 72 hrs/week. Please verify compliance with flag state requirements.
