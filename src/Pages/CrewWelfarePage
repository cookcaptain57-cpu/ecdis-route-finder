// ─── TOOL: LEAVE PLANNER ─────────────────────────────────────────────────────
function LeavePlanner() {
  const [join,     setJoin]     = useState("");
  const [contract, setContract] = useState("9");
  const [ratio,    setRatio]    = useState("1:2");
  const [planned,  setPlanned]  = useState("30");

  const ratioMap = { "1:1":1, "1:2":0.5, "1:3":0.333, "2:1":2, "3:1":3 };
  const cm  = parseFloat(contract) || 0;
  const pl  = parseFloat(planned)  || 0;
  const rv  = ratioMap[ratio]       || 0.5;
  const sea = cm * 30;
  const ear = sea * rv;
  const bal = ear - pl;

  const dateStr = (base, addMonths, addDays) => {
    if (!base) return null;
    try {
      const d = new Date(base);
      if (isNaN(d.getTime())) return null;
      d.setMonth(d.getMonth() + (addMonths||0));
      d.setDate(d.getDate()  + (addDays||0));
      return d.toLocaleDateString("en-GB", { day:"2-digit", month:"short", year:"numeric" });
    } catch { return null; }
  };

  return (
    <div>
      <Head icon="🗓" title="Leave Planner" sub="Calculate earned leave and next sign-on" />
      <div style={cardStyle}>
        <G2>
          <Field label="Join Date">
            <input style={inputStyle} type="date" value={join} onChange={e => setJoin(e.target.value)} />
          </Field>
          <Field label="Contract (months)">
            <input style={inputStyle} type="number" value={contract} onChange={e => setContract(e.target.value)} placeholder="9" />
          </Field>
        </G2>
        <G2>
          <Field label="Leave Ratio (leave:sea)">
            <select style={inputStyle} value={ratio} onChange={e => setRatio(e.target.value)}>
              {Object.keys(ratioMap).map(r => <option key={r} value={r}>{r}</option>)}
            </select>
          </Field>
          <Field label="Planned Leave Days">
            <input style={inputStyle} type="number" value={planned} onChange={e => setPlanned(e.target.value)} placeholder="30" />
          </Field>
        </G2>
        {cm > 0 && (
          <>
            <Row label="Sea Days"                 value={f(sea,0) + " days"} />
            <Row label={"Earned Leave (" + ratio + ")"} value={f(ear,0) + " days"} color="var(--cyan)" />
            {dateStr(join,cm)    && <Row label="Contract End"      value={dateStr(join,cm)}    color="var(--gold)" />}
            {dateStr(join,cm,pl) && <Row label="Est. Next Sign-On" value={dateStr(join,cm,pl)} color="var(--green)" />}
            <Row label="Leave Balance" value={f(bal,0) + " days"} color={bal>=0?"var(--green)":"var(--red)"} />
          </>
        )}
      </div>
    </div>
  );
}

// ─── TOOL: RELIEF DATE CALCULATOR ────────────────────────────────────────────
function ReliefDateCalc() {
  const [join,  setJoin]  = useState("");
  const [minMo, setMinMo] = useState("7");
  const [maxMo, setMaxMo] = useState("11");

  const today = new Date();

  const addMo = (ds, mo) => {
    if (!ds) return null;
    try { const d = new Date(ds); if (isNaN(d.getTime())) return null; d.setMonth(d.getMonth()+(mo||0)); return d; }
    catch { return null; }
  };

  const fmtD = d => d ? d.toLocaleDateString("en-GB",{weekday:"short",day:"2-digit",month:"short",year:"numeric"}) : "—";

  const minD = addMo(join, parseFloat(minMo)||0);
  const maxD = addMo(join, parseFloat(maxMo)||0);
  const dob  = join ? Math.floor((today - new Date(join))/86400000) : null;
  const dtm  = minD ? Math.max(0, Math.ceil((minD-today)/86400000)) : null;
  const dtx  = maxD ? Math.max(0, Math.ceil((maxD-today)/86400000)) : null;
  const inW  = minD && maxD ? today>=minD && today<=maxD : false;

  return (
    <div>
      <Head icon="🔄" title="Relief Date Calculator" sub="Track your relief window" />
      <div style={cardStyle}>
        <G2>
          <Field label="Join Date">
            <input style={inputStyle} type="date" value={join} onChange={e => setJoin(e.target.value)} />
          </Field>
          <div />
          <Field label="Min Contract (months)">
            <input style={inputStyle} type="number" value={minMo} onChange={e => setMinMo(e.target.value)} placeholder="7" />
          </Field>
          <Field label="Max Contract (months)">
            <input style={inputStyle} type="number" value={maxMo} onChange={e => setMaxMo(e.target.value)} placeholder="11" />
          </Field>
        </G2>
        {join && dob !== null && (
          <>
            <Row label="Days Onboard"         value={dob + " days"} color={dob>210?"var(--red)":"var(--text)"} />
            <Row label="Earliest Relief"      value={fmtD(minD)}    color="var(--cyan)" />
            <Row label="Latest Relief"        value={fmtD(maxD)}    color="var(--gold)" />
            {!inW && dtm > 0 && <Row label="Days Until Window Opens" value={dtm + " days"} color="var(--text2)" />}
            {inW && (
              <>
                <div style={{ marginTop:8, padding:"9px 13px", background:"rgba(0,200,150,0.1)",
                  border:"1px solid var(--green)", borderRadius:9, fontSize:"0.75rem",
                  color:"var(--green)", textAlign:"center" }}>
                  You are currently within your relief window
                </div>
                {dtx !== null && <Row label="Days Until Max Contract" value={dtx + " days"} color="var(--red)" />}
              </>
            )}
          </>
        )}
      </div>
    </div>
  );
}

// ─── TOOL: CONTRACT TRACKER ───────────────────────────────────────────────────
function ContractTracker() {
  const [list,   setList]   = useState([]);
  const [form,   setForm]   = useState({ vessel:"", rank:"", company:"", start:"", end:"", notes:"" });
  const [adding, setAdding] = useState(false);
  const [loaded, setLoaded] = useState(false);

  useEffect(() => {
    try {
      const saved = lsGet("contracts", []);
      setList(Array.isArray(saved) ? saved : []);
    } catch { setList([]); }
    setLoaded(true);
  }, []);

  useEffect(() => {
    if (loaded) lsSet("contracts", list);
  }, [list, loaded]);

  const add = () => {
    if (!form.vessel || !form.start) return;
    setList(prev => [{ ...form, id: Date.now() }, ...prev]);
    setForm({ vessel:"", rank:"", company:"", start:"", end:"", notes:"" });
    setAdding(false);
  };

  const remove = id => setList(prev => prev.filter(c => c.id !== id));

  const totalDays = list.reduce((acc, c) => {
    if (!c.start || !c.end) return acc;
    try { return acc + Math.max(0, Math.floor((new Date(c.end)-new Date(c.start))/86400000)); }
    catch { return acc; }
  }, 0);

  return (
    <div>
      <Head icon="📋" title="Contract Tracker" sub="Log your sea service history" />
      <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", marginBottom:10 }}>
        <span style={{ fontSize:"0.72rem", color:"var(--text2)" }}>{list.length} contracts · {f(totalDays,0)} total days</span>
        <Btn small onClick={() => setAdding(a => !a)}>{adding ? "Cancel" : "+ Add"}</Btn>
      </div>
      {adding && (
        <div style={{ ...cardStyle, border:"1px solid rgba(0,180,216,0.3)", marginBottom:12 }}>
          <G2>
            <Field label="Vessel">  <input style={inputStyle} value={form.vessel}  onChange={e => setForm(p=>({...p,vessel:e.target.value}))}  placeholder="MV Example" /></Field>
            <Field label="Rank">    <input style={inputStyle} value={form.rank}    onChange={e => setForm(p=>({...p,rank:e.target.value}))}    placeholder="2nd Officer" /></Field>
            <Field label="Company"> <input style={inputStyle} value={form.company} onChange={e => setForm(p=>({...p,company:e.target.value}))} placeholder="Shipping Co." /></Field>
            <div />
            <Field label="Start Date"> <input style={inputStyle} type="date" value={form.start} onChange={e => setForm(p=>({...p,start:e.target.value}))} /></Field>
            <Field label="End Date">   <input style={inputStyle} type="date" value={form.end}   onChange={e => setForm(p=>({...p,end:e.target.value}))}   /></Field>
          </G2>
          <Field label="Notes">
            <textarea value={form.notes} onChange={e => setForm(p=>({...p,notes:e.target.value}))}
              placeholder="Flag, trade area, vessel type..."
              style={{ ...inputStyle, minHeight:50, resize:"vertical" }} />
          </Field>
          <Btn onClick={add} style={{ marginTop:6 }}>Save Contract</Btn>
        </div>
      )}
      {list.length === 0 && !adding && (
        <div style={{ ...cardStyle, textAlign:"center", color:"var(--text3)", fontSize:"0.77rem", padding:"1.5rem" }}>
          No contracts yet. Add your first one above.
        </div>
      )}
      {list.map(c => {
        let days = null;
        try { if (c.start && c.end) days = Math.max(0, Math.floor((new Date(c.end)-new Date(c.start))/86400000)); } catch {}
        return (
          <div key={c.id} style={{ ...cardStyle, marginBottom:8 }}>
            <div style={{ display:"flex", justifyContent:"space-between" }}>
              <div>
                <div style={{ fontFamily:"'Orbitron',monospace", fontSize:"0.8rem", color:"var(--cyan)", marginBottom:3 }}>{c.vessel}</div>
                <div style={{ fontSize:"0.73rem", color:"var(--text2)" }}>{c.rank}{c.company?" · "+c.company:""}</div>
                <div style={{ fontSize:"0.68rem", color:"var(--text3)", marginTop:3 }}>
                  {c.start} to {c.end||"ongoing"}{days!==null?" · "+days+" days":""}
                </div>
                {c.notes && <div style={{ fontSize:"0.66rem", color:"var(--text3)", marginTop:2 }}>{c.notes}</div>}
              </div>
              <button onClick={() => remove(c.id)}
                style={{ background:"none", border:"none", color:"var(--red)", cursor:"pointer", fontSize:"1rem" }}>x</button>
            </div>
          </div>
        );
      })}
    </div>
  );
}

