        <Input type="number" value={income} onChange={setIncome} placeholder="e.g. 2000" />
        <div style={{ marginTop: 10 }}>
          <Label>Monthly Expenses / Allotment ({cur?.symbol})</Label>
          <Input type="number" value={expenses} onChange={setExpenses} placeholder="e.g. 400" />
        </div>
        <div style={{ marginTop: 10 }}>
          <Label>Existing Savings ({cur?.symbol})</Label>
          <Input type="number" value={existing} onChange={setExisting} placeholder="e.g. 5000" />
        </div>
        <div style={{ marginTop: 10 }}>
          <Label>Savings Goal ({cur?.symbol}) — optional</Label>
          <Input type="number" value={goal} onChange={setGoal} placeholder="e.g. 20000" />
        </div>

        {inc > 0 && (
          <>
            <Result label="Monthly Savings" value={`${cur?.symbol}${fmt(monthlySavings)}`} color={monthlySavings >= 0 ? "var(--green)" : "var(--red)"} />
            <Result label="Savings Rate" value={`${fmt(savingsRate, 1)}%`} color={savingsRate >= 30 ? "var(--green)" : savingsRate >= 10 ? "var(--gold)" : "var(--red)"} />
            <Result label={`Contract Savings (${months} mo)`} value={`${cur?.symbol}${fmt(contractSavings)}`} color="var(--cyan)" />
            <Result label="Total incl. existing" value={`${cur?.symbol}${fmt(totalWithExisting)}`} color="var(--gold)" />
            {g > 0 && (
              <>
                <div style={{ marginTop: 10 }}>
                  <div style={{ display: "flex", justifyContent: "space-between", fontSize: "0.7rem", color: "var(--text2)", marginBottom: 6 }}>
                    <span>Goal progress</span>
                    <span style={{ color: "var(--cyan)" }}>{fmt(progressPct, 1)}%</span>
                  </div>
                  <div style={{ height: 8, background: "var(--bg)", borderRadius: 4, overflow: "hidden" }}>
                    <div style={{ height: "100%", width: `${progressPct}%`, background: "linear-gradient(90deg,var(--cyan),var(--green))", borderRadius: 4, transition: "width 0.4s" }} />
                  </div>
                </div>
                {monthsToGoal && <Result label="Months to reach goal" value={`${monthsToGoal} months`} color="var(--purple)" />}
              </>
            )}
          </>
        )}
      </Card>
    </div>
  );
}

// ─── TOOL 6: LEAVE PLANNER ────────────────────────────────────────────────────
function LeavePlanner() {
  const [joinDate, setJoinDate] = useState(() => LS.get("lv_join", ""));
  const [contractMonths, setContractMonths] = useState(() => LS.get("lv_contract", "9"));
  const [leaveRatio, setLeaveRatio] = useState(() => LS.get("lv_ratio", "1:2"));
  const [plannedLeave, setPlannedLeave] = useState(() => LS.get("lv_planned", "30"));

  useEffect(() => { LS.set("lv_join", joinDate); LS.set("lv_contract", contractMonths); LS.set("lv_ratio", leaveRatio); LS.set("lv_planned", plannedLeave); }, [joinDate, contractMonths, leaveRatio, plannedLeave]);

  const ratioMap = { "1:1": 1, "1:2": 0.5, "1:3": 0.333, "2:1": 2, "3:1": 3 };
  const rVal = ratioMap[leaveRatio] || 0.5;
  const cm = parseFloat(contractMonths) || 0;
  const pl = parseFloat(plannedLeave) || 0;

  const seaDays = cm * 30;
  const earnedLeaveDays = seaDays * rVal;
  const leaveEndDate = joinDate ? (() => {
    const d = new Date(joinDate);
    d.setMonth(d.getMonth() + cm);
    return d.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" });
  })() : null;

  const nextSignOnDate = joinDate && pl > 0 ? (() => {
    const d = new Date(joinDate);
    d.setMonth(d.getMonth() + cm);
    d.setDate(d.getDate() + pl);
    return d.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" });
  })() : null;

  const leaveBalance = earnedLeaveDays - pl;

  return (
    <div>
      <SectionTitle icon="🗓️" title="Leave Planner" subtitle="Calculate earned leave and plan your next sign-on" />
      <Card>
        <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 12, marginBottom: 12 }}>
