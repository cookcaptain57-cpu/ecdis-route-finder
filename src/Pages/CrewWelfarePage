// ── CONTRACTS ─────────────────────────────────────────────────────────────────
function ContractsTool() {
  const [list,setList]=useState([]), [form,setForm]=useState({vessel:"",rank:"",company:"",start:"",end:"",notes:""}), [adding,setAdding]=useState(false), [loaded,setLoaded]=useState(false);
  useEffect(()=>{try{const s=localStorage.getItem("cw_contracts");if(s){const p=JSON.parse(s);if(Array.isArray(p))setList(p);}}catch(e){}setLoaded(true);},[]);
  useEffect(()=>{if(loaded)try{localStorage.setItem("cw_contracts",JSON.stringify(list));}catch(e){};},[list,loaded]);
  const add=()=>{if(!form.vessel||!form.start)return;setList(p=>[{...form,id:Date.now()},...p]);setForm({vessel:"",rank:"",company:"",start:"",end:"",notes:""});setAdding(false);};
  const totalDays=list.reduce((a,c)=>{if(!c.start||!c.end)return a;try{return a+Math.max(0,Math.floor((new Date(c.end)-new Date(c.start))/86400000));}catch(e){return a;}},0);
  return (
    <div>
      <Head icon="📋" title="Contract Tracker" sub="Sea service history log"/>
      <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:12}}>
        <span style={{fontSize:11,color:"#666"}}>{list.length} contracts — {f(totalDays,0)} total days</span>
        <button onClick={()=>setAdding(a=>!a)} style={{background:"#1f2937",border:"1px solid #374151",color:"#aaa",borderRadius:6,padding:"6px 14px",fontSize:11,cursor:"pointer"}}>{adding?"CANCEL":"+ ADD"}</button>
      </div>
      {adding&&<Box style={{borderColor:"#2563eb44",marginBottom:14}}>
        <G2>
          <div><Lbl>VESSEL</Lbl><Inp value={form.vessel} onChange={e=>setForm(p=>({...p,vessel:e.target.value}))} placeholder="MV Example"/></div>
          <div><Lbl>RANK</Lbl><Inp value={form.rank} onChange={e=>setForm(p=>({...p,rank:e.target.value}))} placeholder="2nd Officer"/></div>
          <div><Lbl>COMPANY</Lbl><Inp value={form.company} onChange={e=>setForm(p=>({...p,company:e.target.value}))} placeholder="Shipping Co."/></div>
          <div></div>
          <div><Lbl>START</Lbl><Inp type="date" value={form.start} onChange={e=>setForm(p=>({...p,start:e.target.value}))}/></div>
          <div><Lbl>END</Lbl><Inp type="date" value={form.end} onChange={e=>setForm(p=>({...p,end:e.target.value}))}/></div>
        </G2>
        <Lbl>NOTES</Lbl>
        <textarea value={form.notes} onChange={e=>setForm(p=>({...p,notes:e.target.value}))} placeholder="Flag, trade area..."
          style={{width:"100%",background:"#0d0d0d",border:"1px solid #2a2a2a",borderRadius:6,padding:"8px 12px",color:"#e5e5e5",fontSize:12,minHeight:50,resize:"vertical",outline:"none",boxSizing:"border-box",marginTop:4}}/>
        <button onClick={add} style={{background:"#dc2626",color:"#fff",border:"none",borderRadius:6,padding:"8px 16px",fontSize:11,fontWeight:700,cursor:"pointer",marginTop:10}}>SAVE</button>
      </Box>}
      {list.length===0&&!adding&&<div style={{textAlign:"center",color:"#444",fontSize:12,padding:30}}>No contracts yet.</div>}
      {list.map(c=>{
        let days=null;try{if(c.start&&c.end)days=Math.max(0,Math.floor((new Date(c.end)-new Date(c.start))/86400000));}catch(e){}
        return <Box key={c.id} style={{marginBottom:8}}>
          <div style={{display:"flex",justifyContent:"space-between"}}>
            <div>
              <div style={{fontSize:13,fontWeight:700,color:"#60a5fa",marginBottom:3}}>{c.vessel}</div>
              <div style={{fontSize:11,color:"#888"}}>{c.rank}{c.company?" — "+c.company:""}</div>
              <div style={{fontSize:10,color:"#555",marginTop:3}}>{c.start} to {c.end||"ongoing"}{days!==null?" — "+days+" days":""}</div>
              {c.notes&&<div style={{fontSize:10,color:"#444",marginTop:2}}>{c.notes}</div>}
            </div>
            <button onClick={()=>setList(p=>p.filter(x=>x.id!==c.id))} style={{background:"none",border:"none",color:"#ef4444",cursor:"pointer",fontSize:16,padding:"0 4px"}}>x</button>
          </div>
        </Box>;
      })}
    </div>
  );
}

// ── MENTAL HEALTH ─────────────────────────────────────────────────────────────
const MH_Q=[
  {id:"mh1",text:"Felt down, hopeless or little interest in activities"},
  {id:"mh2",text:"Felt anxious, nervous or on edge"},
  {id:"mh3",text:"Had trouble sleeping or sleeping too much"},
  {id:"mh4",text:"Felt isolated or disconnected from family and friends"},
  {id:"mh5",text:"Been irritable, angry or easily frustrated"},
  {id:"mh6",text:"Had difficulty concentrating on tasks"},
  {id:"mh7",text:"Been consuming alcohol more than usual"},
  {id:"mh8",text:"Had thoughts of harming yourself",crisis:true},
];
function MentalTool() {
  const [ans,setAns]=useState({});
  const labels=["Never","Rarely","Sometimes","Often","Always"];
  const crisis=(ans["mh8"]||0)>=3;
  const allDone=MH_Q.every(q=>ans[q.id]!==undefined);
  const score=allDone?MH_Q.reduce((a,q)=>a+(ans[q.id]||0),0):null;
  const risk=score===null?null:score<=4?{label:"Low — Coping Well",color:"#16a34a"}:score<=12?{label:"Moderate — Monitor",color:"#d97706"}:score<=20?{label:"High — Seek Support",color:"#dc2626"}:{label:"Critical — Get Help Now",color:"#dc2626"};
  return (
    <div>
      <Head icon="🧠" title="Mental Health Self-Check" sub="Private — stored locally only"/>
      {crisis&&<div style={{padding:"12px 16px",background:"#1a0000",border:"2px solid #dc2626",borderRadius:8,marginBottom:16,fontSize:12,color:"#ef4444",lineHeight:1.7}}>
        If you are having thoughts of harming yourself please reach out immediately. SeafarerHelp: +44 20 7323 2737 — free, confidential, 24 hours a day.
      </div>}
      <Box>
        <div style={{fontSize:11,color:"#666",marginBottom:14,lineHeight:1.7}}>Rate each statement over the past 2 weeks. Answers never leave your device.</div>
        {MH_Q.map((q,i)=>(
          <div key={q.id} style={{marginBottom:14,paddingBottom:14,borderBottom:i<MH_Q.length-1?"1px solid #161616":"none"}}>
            <div style={{fontSize:12,color:"#e5e5e5",marginBottom:8,lineHeight:1.5}}>
              <span style={{color:"#555",marginRight:6}}>{i+1}.</span>{q.text}{q.crisis&&<span style={{color:"#ef4444",marginLeft:6}}>!</span>}
            </div>
            <div style={{display:"flex",gap:5,flexWrap:"wrap"}}>
              {labels.map((lbl,val)=>{
                const sel=ans[q.id]===val;
                return <button key={val} onClick={()=>setAns(a=>({...a,[q.id]:val}))}
                  style={{padding:"5px 10px",borderRadius:5,fontSize:11,cursor:"pointer",border:"1px solid "+(sel?"#2563eb":"#2a2a2a"),background:sel?"#172554":"#0d0d0d",color:sel?"#60a5fa":"#888"}}>{lbl}</button>;
              })}
            </div>
          </div>
        ))}
        {risk&&<div style={{marginTop:12,padding:"12px 14px",background:risk.color+"18",border:"1px solid "+risk.color+"55",borderRadius:8}}>
          <div style={{display:"flex",justifyContent:"space-between",marginBottom:8}}>
            <span style={{fontSize:13,fontWeight:700,color:risk.color}}>{risk.label}</span>
            <span style={{fontSize:12,color:risk.color,fontFamily:"monospace"}}>{score}/{MH_Q.length*4}</span>
          </div>
          <div style={{height:6,background:"#1f1f1f",borderRadius:4,overflow:"hidden"}}><div style={{height:"100%",width:((score/(MH_Q.length*4))*100)+"%",background:risk.color,borderRadius:4}}/></div>
          {score>4&&<div style={{marginTop:10,fontSize:11,color:"#888"}}>SeafarerHelp: +44 20 7323 2737 — free, 24/7</div>}
        </div>}
        {!allDone&&<div style={{fontSize:11,color:"#555",marginTop:8}}>Answer all {MH_Q.length} questions to see your result.</div>}
        <button onClick={()=>setAns({})} style={{background:"#1f2937",border:"1px solid #374151",color:"#aaa",borderRadius:6,padding:"6px 14px",fontSize:11,cursor:"pointer",marginTop:12}}>RESET</button>
      </Box>
    </div>
  );
}

// ── FATIGUE ───────────────────────────────────────────────────────────────────
const FAT_Q=[
  {id:"f1",text:"Hours slept in last 24 hours",opts:["Less than 4","4 to 5","5 to 6","6 to 7","7 to 8","More than 8"],w:[5,4,3,2,1,0]},
  {id:"f2",text:"Hours on duty in last 24 hours",opts:["8 or less","9 to 10","11 to 12","13 to 14","More than 14"],w:[0,1,2,3,5]},
  {id:"f3",text:"Days since last proper rest day",opts:["0 to 1","2 to 3","4 to 5","6 to 7","More than 7"],w:[0,1,2,3,5]},
  {id:"f4",text:"Sea conditions affecting your rest",opts:["Calm","Moderate","Rough","Very rough","Extreme"],w:[0,1,2,3,4]},
  {id:"f5",text:"Times woken during last sleep",opts:["None","1 to 2","3 to 4","More than 4"],w:[0,1,2,3]},
];
function FatigueTool() {
  const [ans,setAns]=useState({});
  const allDone=FAT_Q.every(q=>ans[q.id]!==undefined);
  const score=allDone?FAT_Q.reduce((a,q)=>a+(q.w[ans[q.id]]||0),0):null;
  const risk=score===null?null:score<=5?{label:"Low — Fit for Duty",color:"#16a34a",advice:"Levels manageable. Maintain regular rest."}:score<=11?{label:"Moderate — Monitor",color:"#d97706",advice:"Plan extra rest. Avoid complex navigation if possible."}:score<=17?{label:"High — Caution",color:"#dc2626",advice:"Inform OOW and Master. Avoid solo watchkeeping."}:{label:"Critical — Not Fit",color:"#dc2626",advice:"Do NOT stand watch. Notify Master. Rest is mandatory per MLC 2006."};
  return (
    <div>
      <Head icon="😴" title="Fatigue Assessment" sub="MLC 2006 and STCW rest hour awareness"/>
      <Box>
        {FAT_Q.map((q,i)=>(
          <div key={q.id} style={{marginBottom:14,paddingBottom:14,borderBottom:i<FAT_Q.length-1?"1px solid #161616":"none"}}>
            <div style={{fontSize:12,color:"#e5e5e5",marginBottom:8}}><span style={{color:"#555",marginRight:6}}>{i+1}.</span>{q.text}</div>
            <div style={{display:"flex",gap:5,flexWrap:"wrap"}}>
              {q.opts.map((opt,idx)=>{
                const sel=ans[q.id]===idx;
                return <button key={idx} onClick={()=>setAns(a=>({...a,[q.id]:idx}))}
                  style={{padding:"5px 10px",borderRadius:5,fontSize:11,cursor:"pointer",border:"1px solid "+(sel?"#2563eb":"#2a2a2a"),background:sel?"#172554":"#0d0d0d",color:sel?"#60a5fa":"#888"}}>{opt}</button>;
              })}
            </div>
          </div>
        ))}
        {risk&&<div style={{marginTop:12,padding:"12px 14px",background:risk.color+"18",border:"1px solid "+risk.color+"55",borderRadius:8}}>
          <div style={{display:"flex",justifyContent:"space-between",marginBottom:8}}>
            <span style={{fontSize:13,fontWeight:700,color:risk.color}}>{risk.label}</span>
            <span style={{fontSize:12,color:risk.color,fontFamily:"monospace"}}>{score}/22</span>
          </div>
          <div style={{height:6,background:"#1f1f1f",borderRadius:4,overflow:"hidden",marginBottom:10}}><div style={{height:"100%",width:((score/22)*100)+"%",background:risk.color,borderRadius:4}}/></div>
          <div style={{fontSize:11,color:"#888",lineHeight:1.7}}>{risk.advice}</div>
        </div>}
        {!allDone&&<div style={{fontSize:11,color:"#555",marginTop:8}}>Answer all {FAT_Q.length} questions to see your result.</div>}
        <button onClick={()=>setAns({})} style={{background:"#1f2937",border:"1px solid #374151",color:"#aaa",borderRadius:6,padding:"6px 14px",fontSize:11,cursor:"pointer",marginTop:12}}>RESET</button>
      </Box>
    </div>
  );
}

