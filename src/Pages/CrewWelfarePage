// ─── TOOL 6: LEAVE PLANNER ────────────────────────────────────────────────────
function LeavePlanner() {
  const [join,      setJoin]     = useState("");
  const [contract,  setContract] = useState("9");
  const [ratio,     setRatio]    = useState("1:2");
  const [planned,   setPlanned]  = useState("30");

  const ratioMap = { "1:1":1, "1:2":0.5, "1:3":0.333, "2:1":2, "3:1":3 };
  const rVal = ratioMap[ratio] || 0.5;
  const cm = parseFloat(contract) || 0;
  const pl = parseFloat(planned)  || 0;

  const seaDays    = cm * 30;
  const earnedDays = seaDays * rVal;
  const balance    = earnedDays - pl;

  const addMonths = (ds, mo) => {
    if (!ds) return null;
    const d = new Date(ds); d.setMonth(d.getMonth() + mo);
    return d.toLocaleDateString("en-GB",{day:"2-digit",month:"short",year:"numeric"});
  };
  const addDays = (ds, mo, days) => {
    if (!ds) return null;
    const d = new Date(ds); d.setMonth(d.getMonth() + mo); d.setDate(d.getDate() + days);
    return d.toLocaleDateString("en-GB",{day:"2-digit",month:"short",year:"numeric"});
  };

  return (
    <div>
      <SectionHead icon="🗓️" title="Leave Planner" sub="Calculate earned leave days" />
      <div style={C.card}>
        <Grid2>
          <Field label="Join Date">
            <input style={C.input} type="date" value={join} onChange={e => setJoin(e.target.value)} />
          </Field>
          <Field label="Contract (months)">
            <input style={C.input} type="number" value={contract} onChange={e => setContract(e.target.value)} placeholder="9" />
          </Field>
        </Grid2>
        <Grid2>
          <Field label="Leave Ratio (leave:sea)">
            <select style={C.select} value={ratio} onChange={e => setRatio(e.target.value)}>
              {Object.keys(ratioMap).map(r => <option key={r} value={r}>{r}</option>)}
            </select>
          </Field>
          <Field label="Planned Leave Days">
            <input style={C.input} type="number" value={planned} onChange={e => setPlanned(e.target.value)} placeholder="30" />
          </Field>
        </Grid2>
        {cm > 0 && (
          <>
            <Row label="Sea Days"              value={`${fmt(seaDays,0)} days`} />
            <Row label={`Earned Leave (${ratio})`} value={`${fmt(earnedDays,0)} days`} color="var(--cyan)" />
            {join && <Row label="Contract End"  value={addMonths(join, cm)} color="var(--gold)" />}
            {join && pl > 0 && <Row label="Est. Next Sign-On" value={addDays(join, cm, pl)} color="var(--green)" />}
            <Row label="Leave Balance" value={`${fmt(balance,0)} days`} color={balance>=0?"var(--green)":"var(--red)"} />
          </>
        )}
      </div>
    </div>
  );
}

// ─── TOOL 7: RELIEF DATE CALCULATOR ─────────────────────────────────────────
function ReliefDateCalc() {
  const [join,    setJoin]    = useState("");
  const [minMo,   setMinMo]   = useState("7");
  const [maxMo,   setMaxMo]   = useState("11");

  const today   = new Date();
  const minDate = join ? (() => { const d = new Date(join); d.setMonth(d.getMonth() + (parseFloat(minMo)||0)); return d; })() : null;
  const maxDate = join ? (() => { const d = new Date(join); d.setMonth(d.getMonth() + (parseFloat(maxMo)||0)); return d; })() : null;
  const fmtDate = d => d ? d.toLocaleDateString("en-GB",{weekday:"short",day:"2-digit",month:"short",year:"numeric"}) : "—";
  const daysOnboard   = join ? Math.floor((today - new Date(join)) / 86400000) : null;
  const daysToMin     = minDate ? Math.max(0, Math.ceil((minDate - today) / 86400000)) : null;
  const daysToMax     = maxDate ? Math.max(0, Math.ceil((maxDate - today) / 86400000)) : null;
  const inWindow      = minDate && maxDate ? today >= minDate && today <= maxDate : false;

  return (
    <div>
      <SectionHead icon="🔄" title="Relief Date Calculator" sub="Track your relief window" />
      <div style={C.card}>
        <Grid2>
          <Field label="Join Date">
            <input style={C.input} type="date" value={join} onChange={e => setJoin(e.target.value)} />
          </Field>
          <div />
          <Field label="Min Contract (months)">
            <input style={C.input} type="number" value={minMo} onChange={e => setMinMo(e.target.value)} placeholder="7" />
          </Field>
          <Field label="Max Contract (months)">
            <input style={C.input} type="number" value={maxMo} onChange={e => setMaxMo(e.target.value)} placeholder="11" />
          </Field>
        </Grid2>
        {join && daysOnboard !== null && (
          <>
            <Row label="Days Onboard So Far"  value={`${daysOnboard} days`} color={daysOnboard>210?"var(--red)":"var(--text)"} />
            <Row label="Earliest Relief Date" value={fmtDate(minDate)} color="var(--cyan)" />
            <Row label="Latest Relief Date"   value={fmtDate(maxDate)} color="var(--gold)" />
            {!inWindow && daysToMin > 0 && <Row label="Days Until Window Opens" value={`${daysToMin} days`} color="var(--text2)" />}
            {inWindow && (
              <>
                <div style={{ marginTop:8, padding:"9px 13px", background:"rgba(0,200,150,0.1)", border:"1px solid var(--green)", borderRadius:9, fontSize:"0.77rem", color:"var(--green)", textAlign:"center" }}>
                  ✅ You are within your relief window
                </div>
                <Row label="Days Until Max Contract" value={`${daysToMax} days`} color="var(--red)" />
              </>
            )}
            {daysToMax === 0 && (
              <div style={{ marginTop:8, padding:"9px 13px", background:"rgba(255,71,87,0.1)", border:"1px solid var(--red)", borderRadius:9, fontSize:"0.77rem", color:"var(--red)", textAlign:"center" }}>
                ⚠️ Max contract reached — relief required
              </div>
            )}
          </>
        )}
      </div>
    </div>
  );
}

// ─── TOOL 8: CONTRACT TRACKER ─────────────────────────────────────────────────
function ContractTracker() {
  const [list, setList]     = useState(() => lsGet("contracts", []));
  const [form, setForm]     = useState({ vessel:"", rank:"", company:"", start:"", end:"", notes:"" });
  const [adding, setAdding] = useState(false);

  useEffect(() => { lsSet("contracts", list); }, [list]);

  const add = () => {
    if (!form.vessel || !form.start) return;
    setList(prev => [{ ...form, id: Date.now() }, ...prev]);
    setForm({ vessel:"", rank:"", company:"", start:"", end:"", notes:"" });
    setAdding(false);
  };

  const remove = id => setList(prev => prev.filter(c => c.id !== id));
  const totalDays = list.reduce((acc, c) => {
    if (!c.start || !c.end) return acc;
    return acc + Math.max(0, Math.floor((new Date(c.end) - new Date(c.start)) / 86400000));
  }, 0);

  return (
    <div>
      <SectionHead icon="📋" title="Contract Tracker" sub="Log your sea service history" />
      <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", marginBottom:10 }}>
        <span style={{ fontSize:"0.73rem", color:"var(--text2)" }}>{list.length} contracts · {fmt(totalDays,0)} total sea days</span>
        <Btn small onClick={() => setAdding(a => !a)}>{adding ? "✕ Cancel" : "+ Add"}</Btn>
      </div>
      {adding && (
        <div style={{ ...C.card, border:"1px solid rgba(0,180,216,0.3)", marginBottom:12 }}>
          <Grid2>
            <Field label="Vessel"><input style={C.input} value={form.vessel} onChange={e => setForm(f=>({...f,vessel:e.target.value}))} placeholder="MV Example" /></Field>
            <Field label="Rank"><input style={C.input} value={form.rank} onChange={e => setForm(f=>({...f,rank:e.target.value}))} placeholder="2nd Officer" /></Field>
            <Field label="Company"><input style={C.input} value={form.company} onChange={e => setForm(f=>({...f,company:e.target.value}))} placeholder="Shipping Co." /></Field>
            <div />
            <Field label="Start Date"><input style={C.input} type="date" value={form.start} onChange={e => setForm(f=>({...f,start:e.target.value}))} /></Field>
            <Field label="End Date"><input style={C.input} type="date" value={form.end} onChange={e => setForm(f=>({...f,end:e.target.value}))} /></Field>
          </Grid2>
          <Field label="Notes">
            <textarea value={form.notes} onChange={e => setForm(f=>({...f,notes:e.target.value}))} placeholder="Flag, trade area, vessel type..."
              style={{ ...C.input, minHeight:50, resize:"vertical" }} />
          </Field>
          <Btn onClick={add} style={{ marginTop:4 }}>💾 Save</Btn>
        </div>
      )}
      {list.length === 0 && !adding && (
        <div style={{ ...C.card, textAlign:"center", color:"var(--text3)", fontSize:"0.78rem", padding:"1.5rem" }}>
          No contracts yet. Add your first one above.
        </div>
      )}
      {list.map(c => {
        const days = c.start && c.end ? Math.max(0, Math.floor((new Date(c.end)-new Date(c.start))/86400000)) : null;
        return (
          <div key={c.id} style={{ ...C.card, marginBottom:8 }}>
            <div style={{ display:"flex", justifyContent:"space-between" }}>
              <div>
                <div style={{ fontFamily:"'Orbitron',monospace", fontSize:"0.82rem", color:"var(--cyan)", marginBottom:3 }}>{c.vessel}</div>
                <div style={{ fontSize:"0.75rem", color:"var(--text2)" }}>{c.rank}{c.company?` · ${c.company}`:""}</div>
                <div style={{ fontSize:"0.7rem", color:"var(--text3)", marginTop:3 }}>
                  {c.start} → {c.end||"ongoing"}{days!==null?` · ${days} days`:""}
                </div>
                {c.notes && <div style={{ fontSize:"0.68rem", color:"var(--text3)", marginTop:2 }}>{c.notes}</div>}
              </div>
              <button onClick={() => remove(c.id)} style={{ background:"none", border:"none", color:"var(--red)", cursor:"pointer", fontSize:"1rem" }}>✕</button>
            </div>
          </div>
        );
      })}
    </div>
  );
}

