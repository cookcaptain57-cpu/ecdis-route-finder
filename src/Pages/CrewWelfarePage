  const [goal, setGoal] = useState(() => LS.get("sav_goal", ""));
  const [months, setMonths] = useState(() => LS.get("sav_months", "9"));
  const [expenses, setExpenses] = useState(() => LS.get("sav_expenses", ""));
  const [existing, setExisting] = useState(() => LS.get("sav_existing", "0"));

  useEffect(() => { LS.set("sav_income", income); LS.set("sav_currency", currency); LS.set("sav_goal", goal); LS.set("sav_months", months); LS.set("sav_expenses", expenses); LS.set("sav_existing", existing); }, [income, currency, goal, months, expenses, existing]);

  const inc = parseFloat(income) || 0;
  const exp = parseFloat(expenses) || 0;
  const g = parseFloat(goal) || 0;
  const m = parseFloat(months) || 1;
  const ex = parseFloat(existing) || 0;
  const cur = CURRENCIES.find(c => c.code === currency);

  const monthlySavings = inc - exp;
  const contractSavings = monthlySavings * m;
  const totalWithExisting = contractSavings + ex;
  const savingsRate = inc > 0 ? (monthlySavings / inc) * 100 : 0;
  const monthsToGoal = g > 0 && monthlySavings > 0 ? Math.ceil((g - ex) / monthlySavings) : null;
  const progressPct = g > 0 ? Math.min(100, (totalWithExisting / g) * 100) : 0;

  return (
    <div>
