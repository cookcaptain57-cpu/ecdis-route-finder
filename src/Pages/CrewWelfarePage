  const [adding, setAdding] = useState(false);

  useEffect(() => { LS.set("ct_list", contracts); }, [contracts]);

  const addContract = () => {
    if (!form.vessel || !form.start) return;
    setContracts(prev => [{ ...form, id: Date.now() }, ...prev]);
    setForm({ vessel: "", rank: "", company: "", start: "", end: "", notes: "" });
    setAdding(false);
  };

  const removeContract = id => setContracts(prev => prev.filter(c => c.id !== id));

  const totalDays = contracts.reduce((acc, c) => {
    if (!c.start || !c.end) return acc;
    return acc + Math.max(0, Math.floor((new Date(c.end) - new Date(c.start)) / 86400000));
  }, 0);

  return (
    <div>
      <SectionTitle icon="📋" title="Contract Tracker" subtitle="Log your sea service history" />

