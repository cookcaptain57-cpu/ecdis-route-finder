// ─── TOOL: LEAVE PLANNER ─────────────────────────────────────────────────────

function LeavePlanner() {
  var [join,     setJoin]     = useState("");
  var [contract, setContract] = useState("9");
  var [ratio,    setRatio]    = useState("1:2");
  var [planned,  setPlanned]  = useState("30");

  var ratioMap = { "1:1":1, "1:2":0.5, "1:3":0.333, "2:1":2, "3:1":3 };
  var cm  = parseFloat(contract) || 0;
  var pl  = parseFloat(planned)  || 0;
  var rv  = ratioMap[ratio]      || 0.5;
  var sea = cm * 30;
  var ear = sea * rv;
  var bal = ear - pl;

  var addDate = function(base, addMonths, addDays) {
    if (!base) return null;
    try {
      var d = new Date(base);
      if (isNaN(d.getTime())) return null;
      d.setMonth(d.getMonth() + (addMonths||0));
      d.setDate(d.getDate() + (addDays||0));
      return d.toLocaleDateString("en-GB", { day:"2-digit", month:"short", year:"numeric" });
    } catch(e) { return null; }
  };

  return (
    <div>
      <SectionHeader icon="🗓" title="Leave Planner" subtitle="Calculate earned leave and next sign-on" />
      <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:10, marginBottom:4 }}>
        <div>
          <Lbl>JOIN DATE</Lbl>
          <Inp type="date" value={join} onChange={function(e){setJoin(e.target.value);}} />
        </div>
        <div>
          <Lbl>CONTRACT (MONTHS)</Lbl>
          <Inp type="number" value={contract} onChange={function(e){setContract(e.target.value);}} placeholder="9" />
        </div>
      </div>
      <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:10, marginTop:4 }}>
        <div>
          <Lbl>LEAVE RATIO (leave:sea)</Lbl>
          <Sel value={ratio} onChange={function(e){setRatio(e.target.value);}}>
            {Object.keys(ratioMap).map(function(r){return <option key={r}>{r}</option>;})}
          </Sel>
        </div>
        <div>
          <Lbl>PLANNED LEAVE DAYS</Lbl>
          <Inp type="number" value={planned} onChange={function(e){setPlanned(e.target.value);}} placeholder="30" />
        </div>
      </div>
      {cm > 0 && (
        <Card style={{ marginTop:12, borderColor:"#1a2a1a" }}>
          <Row label="Sea Days"                      value={fmt(sea,0)+" days"} />
          <Row label={"Earned Leave ("+ratio+")"}    value={fmt(ear,0)+" days"} color="#60a5fa" />
          {addDate(join,cm)    && <Row label="Contract End"      value={addDate(join,cm)}    color="#fbbf24" />}
          {addDate(join,cm,pl) && <Row label="Est. Next Sign-On" value={addDate(join,cm,pl)} color="#4ade80" />}
          <Row label="Leave Balance" value={fmt(bal,0)+" days"} color={bal>=0?"#4ade80":"#ef4444"} />
        </Card>
      )}
    </div>
  );
}

// ─── TOOL: RELIEF DATE CALCULATOR ────────────────────────────────────────────

function ReliefDateCalc() {
  var [join,  setJoin]  = useState("");
  var [minMo, setMinMo] = useState("7");
  var [maxMo, setMaxMo] = useState("11");

  var today = new Date();

  var addMo = function(ds, mo) {
    if (!ds) return null;
    try {
      var d = new Date(ds);
      if (isNaN(d.getTime())) return null;
      d.setMonth(d.getMonth() + (mo||0));
      return d;
    } catch(e) { return null; }
  };

  var fmtD = function(d) {
    if (!d) return "--";
    return d.toLocaleDateString("en-GB", { weekday:"short", day:"2-digit", month:"short", year:"numeric" });
  };

  var minD = addMo(join, parseFloat(minMo)||0);
  var maxD = addMo(join, parseFloat(maxMo)||0);
  var dob  = join ? Math.floor((today - new Date(join))/86400000) : null;
  var dtm  = minD ? Math.max(0, Math.ceil((minD-today)/86400000)) : null;
  var dtx  = maxD ? Math.max(0, Math.ceil((maxD-today)/86400000)) : null;
  var inW  = (minD && maxD) ? (today>=minD && today<=maxD) : false;

  return (
    <div>
      <SectionHeader icon="🔄" title="Relief Date Calculator" subtitle="Track your relief window and days onboard" />
      <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr 1fr", gap:10, marginBottom:4 }}>
        <div>
          <Lbl>JOIN DATE</Lbl>
          <Inp type="date" value={join} onChange={function(e){setJoin(e.target.value);}} />
        </div>
        <div>
          <Lbl>MIN CONTRACT (MO)</Lbl>
          <Inp type="number" value={minMo} onChange={function(e){setMinMo(e.target.value);}} placeholder="7" />
        </div>
        <div>
          <Lbl>MAX CONTRACT (MO)</Lbl>
          <Inp type="number" value={maxMo} onChange={function(e){setMaxMo(e.target.value);}} placeholder="11" />
        </div>
      </div>
      {join && dob !== null && (
        <Card style={{ marginTop:12, borderColor:"#1a1a2a" }}>
          <Row label="Days Onboard"         value={dob+" days"} color={dob>210?"#ef4444":"#e5e5e5"} />
          <Row label="Earliest Relief Date" value={fmtD(minD)}  color="#60a5fa" />
          <Row label="Latest Relief Date"   value={fmtD(maxD)}  color="#fbbf24" />
          {!inW && dtm > 0 && <Row label="Days Until Window Opens" value={dtm+" days"} color="#888" />}
          {inW && (
            <div style={{ marginTop:8, padding:"10px 12px", background:"#0a1a0a", border:"1px solid #16a34a", borderRadius:7, fontSize:12, color:"#4ade80", textAlign:"center" }}>
              You are currently within your relief window
            </div>
          )}
          {inW && dtx !== null && <Row label="Days Until Max Contract" value={dtx+" days"} color="#ef4444" />}
        </Card>
      )}
    </div>
  );
}

// ─── TOOL: CONTRACT TRACKER ───────────────────────────────────────────────────

function ContractTracker() {
  var [list,   setList]   = useState([]);
  var [form,   setForm]   = useState({ vessel:"", rank:"", company:"", start:"", end:"", notes:"" });
  var [adding, setAdding] = useState(false);
  var [loaded, setLoaded] = useState(false);

  useEffect(function() {
    try {
      var saved = localStorage.getItem("cw_contracts");
      if (saved) {
        var parsed = JSON.parse(saved);
        if (Array.isArray(parsed)) setList(parsed);
      }
    } catch(e) {}
    setLoaded(true);
  }, []);

  useEffect(function() {
    if (loaded) {
      try { localStorage.setItem("cw_contracts", JSON.stringify(list)); } catch(e) {}
    }
  }, [list, loaded]);

  var add = function() {
    if (!form.vessel || !form.start) return;
    setList(function(prev) { return [Object.assign({}, form, { id:Date.now() }), ...prev]; });
    setForm({ vessel:"", rank:"", company:"", start:"", end:"", notes:"" });
    setAdding(false);
  };

  var remove = function(id) {
    setList(function(prev) { return prev.filter(function(c){return c.id!==id;}); });
  };

  var totalDays = list.reduce(function(acc, c) {
    if (!c.start || !c.end) return acc;
    try { return acc + Math.max(0, Math.floor((new Date(c.end)-new Date(c.start))/86400000)); }
    catch(e) { return acc; }
  }, 0);

  return (
    <div>
      <SectionHeader icon="📋" title="Contract Tracker" subtitle="Log your sea service history" />
      <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", marginBottom:12 }}>
        <span style={{ fontSize:11, color:"#666" }}>{list.length} contracts — {fmt(totalDays,0)} total days</span>
        <Btn onClick={function(){setAdding(function(a){return !a;});}} color="#1f2937" style={{ border:"1px solid #374151", fontSize:11 }}>
          {adding ? "CANCEL" : "+ ADD CONTRACT"}
        </Btn>
      </div>
      {adding && (
        <Card style={{ borderColor:"#2563eb44", marginBottom:14 }}>
          <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:10 }}>
            <div><Lbl>VESSEL NAME</Lbl><Inp value={form.vessel}  onChange={function(e){setForm(function(p){return Object.assign({},p,{vessel:e.target.value});});}}  placeholder="MV Example" /></div>
            <div><Lbl>RANK</Lbl>       <Inp value={form.rank}    onChange={function(e){setForm(function(p){return Object.assign({},p,{rank:e.target.value});});}}    placeholder="2nd Officer" /></div>
            <div><Lbl>COMPANY</Lbl>    <Inp value={form.company} onChange={function(e){setForm(function(p){return Object.assign({},p,{company:e.target.value});});}} placeholder="Shipping Co." /></div>
            <div></div>
            <div><Lbl>START DATE</Lbl> <Inp type="date" value={form.start} onChange={function(e){setForm(function(p){return Object.assign({},p,{start:e.target.value});});}} /></div>
            <div><Lbl>END DATE</Lbl>   <Inp type="date" value={form.end}   onChange={function(e){setForm(function(p){return Object.assign({},p,{end:e.target.value});});}} /></div>
          </div>
          <Lbl>NOTES</Lbl>
          <textarea value={form.notes} onChange={function(e){setForm(function(p){return Object.assign({},p,{notes:e.target.value});});}}
            placeholder="Flag, trade area, vessel type..."
            style={{ width:"100%", background:"#0d0d0d", border:"1px solid #2a2a2a", borderRadius:6, padding:"8px 12px", color:"#e5e5e5", fontFamily:"'IBM Plex Mono',monospace", fontSize:12, minHeight:50, resize:"vertical", outline:"none", boxSizing:"border-box", marginTop:4 }} />
          <Btn onClick={add} style={{ marginTop:10 }}>SAVE CONTRACT</Btn>
        </Card>
      )}
      {list.length === 0 && !adding && (
        <div style={{ textAlign:"center", color:"#444", fontSize:12, padding:30 }}>No contracts logged yet. Add your first one above.</div>
      )}
      {list.map(function(c) {
        var days = null;
        try { if (c.start && c.end) days = Math.max(0, Math.floor((new Date(c.end)-new Date(c.start))/86400000)); } catch(e) {}
        return (
          <Card key={c.id} style={{ marginBottom:8 }}>
            <div style={{ display:"flex", justifyContent:"space-between" }}>
              <div>
                <div style={{ fontSize:13, fontWeight:700, color:"#60a5fa", marginBottom:3 }}>{c.vessel}</div>
                <div style={{ fontSize:11, color:"#888" }}>{c.rank}{c.company?" — "+c.company:""}</div>
                <div style={{ fontSize:10, color:"#555", marginTop:3 }}>
                  {c.start} to {c.end||"ongoing"}{days!==null?" — "+days+" days":""}
                </div>
                {c.notes && <div style={{ fontSize:10, color:"#444", marginTop:2 }}>{c.notes}</div>}
              </div>
              <button onClick={function(){remove(c.id);}} style={{ background:"none", border:"none", color:"#ef4444", cursor:"pointer", fontSize:16, padding:"0 4px" }}>x</button>
            </div>
          </Card>
        );
      })}
    </div>
  );
}

