        </div>
        <Btn small onClick={() => setAdding(a => !a)}>{adding ? "✕ Cancel" : "+ Add Contract"}</Btn>
      </div>

      {adding && (
        <Card style={{ border: "1px solid var(--cyan)44", marginBottom: 14 }}>
          <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: 10, marginBottom: 10 }}>
